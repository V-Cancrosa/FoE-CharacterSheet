{
  "id": "foe-rpg",
  "title": "Fallout: Equestria RPG (fan, v1.22)",
  "description": "Nieoficjalny, minimalny system do Fallout: Equestria RPG System v1.22 (rzut d100 pod próg, MFD, SPECIAL, karty szczęścia, rany na lokacje).",
  "version": "0.3.1",
  "authors": [{ "name": "V_Cancrosa" }],
  "compatibility": { "minimum": "13", "verified": "13" },
  "esmodules": ["module/foe.mjs"],
  "styles": ["styles/foe.css"],
  "languages": [
    { "lang": "pl", "name": "Polski", "path": "lang/pl.json" },
    { "lang": "en", "name": "English", "path": "lang/en.json" }
