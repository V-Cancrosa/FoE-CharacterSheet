<div class="cr">
  <div class="cr-scroll">
    <p class="cr-desc">{{t "A quick NPC per the rulebook (“Rapid NPC Generation”): choose an archetype, a race and a level. The creator sets S.P.E.C.I.A.L., the racial bonuses and 3 tags, and distributes the skill points from level-ups (10 + INT/2 per level). You can change everything later on the sheet."}}</p>
    <div class="cr-row">
      <label>{{t "Name"}} <input type="text" name="name" value="{{st.name}}"></label>
      <label>{{t "Level"}} <input type="number" name="level" value="{{r.level}}" min="1" max="30"></label>
    </div>
    <div class="cr-row">
      <label>{{t "Archetype"}} <select name="archetype">{{#each archetypes}}<option value="{{k}}" {{#if sel}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
      <label>{{t "Race"}} <select name="race">{{#each races}}<option value="{{k}}" {{#if sel}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
    </div>

    <h3>S.P.E.C.I.A.L.</h3>
    <div class="cr-special">
      {{#each attrs}}<div class="{{#if racial}}racial{{/if}}" title="{{label}}{{#if racial}} {{t "(with the racial bonus)"}}{{/if}}"><span>{{short}}</span><b>{{v}}</b><small>{{mfd}}</small></div>{{/each}}
    </div>

    <h3>{{t "Skills"}} <small>{{t "{n} pts from level-ups" n=levelPoints}}</small></h3>
    <table class="foe-table skills">
      <thead><tr><th class="l">{{t "Skill"}}</th><th>{{t "Attr"}}</th><th>Tag</th><th>{{t "Race"}}</th><th>{{t "Level-ups"}}</th><th>{{t "Rank"}}</th><th>MFD 1</th></tr></thead>
      <tbody>
      {{#each skills}}
        <tr class="{{#if tag}}tagged{{/if}}">
          <td class="l">{{label}}</td><td>{{attrLabel}}</td><td>{{#if tag}}✓{{/if}}</td>
          <td>{{#if bonus}}{{bonus}}{{/if}}</td><td>{{#if points}}{{points}}{{/if}}</td>
          <td><b>{{rank}}</b></td><td class="tn">{{tn}}</td>
        </tr>
      {{/each}}
      </tbody>
    </table>
  </div>
  <footer class="cr-foot">
    <span></span>
    <button type="button" class="primary" data-action="finish"><i class="fa-solid fa-check"></i> {{t "Create NPC"}}</button>
  </footer>
</div>
