<div class="cr">
  <nav class="cr-steps">
    {{#each steps}}<a class="{{#if active}}active{{/if}} {{#if done}}done{{/if}}" data-action="goStep" data-step="{{i}}"><span>{{n}}</span> {{label}}</a>{{/each}}
  </nav>

  <div class="cr-budget">
    <span>{{t "CREATION POINTS"}}</span>
    <span>{{r.pool}} − {{t "7 base"}}{{#if r.hindPts}} + {{t "{n} for hindrances" n=r.hindPts}}{{/if}}{{#if r.traitCost}} − {{t "{n} for traits" n=r.traitCost}}{{/if}} = <b>{{r.budget}}</b></span>
    <span>{{t "cr|spent"}} <b>{{r.spentTotal}}</b></span>
    <span class="cr-left {{remainingCls}}">{{t "cr|left"}} <b>{{r.remaining}}</b></span>
  </div>

  <div class="cr-scroll">
  {{!-- ================= 1. RASA ================= --}}
  {{#if step.race}}
    <h3>{{t "Name and race"}} {{rule "races/overview"}}</h3>
    <div class="cr-row">
      <label>{{t "Name"}} <input type="text" name="name" value="{{st.name}}"></label>
      <label>{{t "Race"}} <select name="race">{{#each races}}<option value="{{k}}" {{#if sel}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
    </div>
    <p class="cr-desc">{{r.race.desc}}</p>
    {{#if r.race.manual}}
      <label class="cr-line">{{t "Race name"}} <input type="text" name="raceName" value="{{st.raceName}}"></label>
      <p class="hint">{{t "Enter the race bonuses by hand: attributes in the “Other” column (S.P.E.C.I.A.L. step), skills in the “Other” column (Skills step). Racial skills are unlocked."}}</p>
    {{else}}
      <h3>{{t "Racial attribute bonus"}} <small>{{t "choose {n}" n=r.race.attrs.pick}}</small></h3>
      <div class="cr-chips">{{#each raceAttrChips}}<a class="chip {{#if on}}on{{/if}}" data-action="toggleRaceAttr" data-key="{{k}}">{{label}} +1</a>{{/each}}</div>

      <h3>{{t "Racial skill bonuses"}}</h3>
      {{#if raceFixed}}<p class="cr-fixed">{{t "Fixed:"}} {{raceFixed}} <span class="hint">{{t "(the rank does not drop below 5)"}}</span></p>{{/if}}
      {{#each raceGroups}}
        <p class="cr-sub">{{t "Choose {n} × +{v}" n=n v=value}} <span class="hint">({{chosenCount}}/{{n}})</span></p>
        <div class="cr-chips">{{#each chips}}<a class="chip {{#if on}}on{{/if}}" data-action="toggleRaceSkill" data-key="{{key}}">{{label}}</a>{{/each}}</div>
      {{/each}}
      {{#unless raceFixed}}{{#unless raceGroups.length}}<p class="hint">{{t "None."}}</p>{{/unless}}{{/unless}}

      {{#if racialSkills.length}}
        <h3>{{t "Racial skills"}}</h3>
        <ul class="cr-list">
        {{#each racialSkills}}
          <li><b>{{label}}</b> +{{bonus}} ({{attrs}})
            {{#if choice}} — {{t "based on"}} <select name="magicAttr">{{#each choice}}<option value="{{v}}" {{#if sel}}selected{{/if}}>{{label}}</option>{{/each}}</select>{{/if}}
          </li>
        {{/each}}
        </ul>
      {{/if}}

      {{#if zebra}}
        <label class="cr-line"><input type="checkbox" name="zebraNoMagic" {{#if zebra.on}}checked{{/if}}> {{t "No zebra magic: instead of Magic +10, two different skills at +5 each (no starting recipes)"}}</label>
        {{#if zebra.on}}<div class="cr-chips">{{#each zebra.chips}}<a class="chip {{#if on}}on{{/if}}" data-action="toggleZebraSplit" data-key="{{k}}">{{label}}</a>{{/each}}</div>{{/if}}
      {{/if}}

      {{#if earthPerks}}
        <h3>{{t "Free earth pony perk"}}</h3>
        <div class="cr-row">{{#each earthPerks}}<label class="cr-radio"><input type="radio" name="earthPerk" value="{{k}}" {{#if sel}}checked{{/if}}> <b>{{label}}</b> — {{desc}}</label>{{/each}}</div>
      {{/if}}

      {{#if autoTraits}}<p class="cr-fixed">{{t "Free racial traits:"}} {{autoTraits}}</p>{{/if}}
      {{#if autoHindrances}}<p class="cr-fixed">{{t "Racial hindrances (mandatory):"}} {{autoHindrances}}</p>{{/if}}
      {{#if r.race.freeTraitPoints}}<p class="cr-fixed">{{t "Free trait: {n} pt deducted from the cost of traits." n=r.race.freeTraitPoints}}</p>{{/if}}
      {{#if r.race.notes.length}}<ul class="cr-notes">{{#each r.race.notes}}<li>{{this}}</li>{{/each}}</ul>{{/if}}
    {{/if}}
  {{/if}}

  {{!-- ================= 2. WADY I CECHY ================= --}}
  {{#if step.flaws}}
    <p class="cr-desc">{{t "Each hindrance gives creation points ({rule}, max. {n} hindrances). Traits cost points. The rulebook recommends at most 3 hindrances and 2 traits to start with. The effects of every hindrance and trait are counted automatically — on the sheet and in rolls; situational ones are ticked in the roll window. Under a selected entry you choose its variants." rule=hindRule n=r.maxHindrances}}</p>
    <div class="cr-row">
      <span class="cr-stat">{{t "Hindrances:"}} <b>{{r.countedHindrances}}</b> → <b>+{{r.hindPts}}</b> {{t "pts"}}</span>
      <span class="cr-stat">{{t "Traits:"}} <b>{{r.rawTraitCost}}</b> {{t "pts"}}{{#if r.credit}} ({{t "− {n} free" n=r.credit}}){{/if}} → <b>−{{r.traitCost}}</b></span>
      <label class="cr-filter"><i class="fa-solid fa-magnifying-glass"></i> <input type="text" name="filter" value="{{st.filter}}" placeholder="{{t "Search…"}}"></label>
    </div>
    <p class="cr-fixed">{{t "Chosen hindrances:"}} <b>{{summary.hindrances}}</b><br>{{t "Chosen traits:"}} <b>{{summary.traits}}</b></p>
    <div class="cr-cols">
      <div>
        <h3>{{t "head|Hindrances"}}</h3>
        <ul class="cr-pick">
        {{#each hindrances}}
          <li class="{{#if on}}on{{/if}} {{#if locked}}locked{{/if}}" data-search="{{search}}">
            <a {{#unless locked}}data-action="toggleHindrance"{{/unless}} data-key="{{k}}"><span class="box"></span><b>{{label}}</b> <span class="ty">{{type}}</span></a>
            <p>{{desc}}</p>
            {{#if fxText.length}}<ul class="cr-fx">{{#each fxText}}<li>{{this}}</li>{{/each}}</ul>{{/if}}
            {{#each choices}}
              <div class="cr-choice">
                <span>{{label}}{{#if many}} ({{count}}/{{n}}){{/if}}</span>
                {{#if many}}
                  <div class="cr-chips">{{#each options}}<a class="chip {{#if sel}}on{{/if}}" data-action="toggleChoice" data-key="{{../key}}" data-id="{{../id}}" data-n="{{../n}}" data-v="{{v}}">{{label}}</a>{{/each}}</div>
                {{else}}
                  <select name="choice.{{key}}.{{id}}"><option value="">{{t "— choose —"}}</option>{{#each options}}<option value="{{v}}" {{#if sel}}selected{{/if}}>{{label}}</option>{{/each}}</select>
                {{/if}}
              </div>
            {{/each}}
          </li>
        {{/each}}
        </ul>
      </div>
      <div>
        <h3>{{t "head|Traits"}}</h3>
        <ul class="cr-pick">
        {{#each traits}}
          <li class="{{#if on}}on{{/if}} {{#if locked}}locked{{/if}}" data-search="{{search}}">
            <a {{#unless locked}}data-action="toggleTrait"{{/unless}} data-key="{{k}}"><span class="box"></span><b>{{label}}</b> <span class="ty">{{#if locked}}{{t "race"}}{{else}}{{#if nowCost}}{{nowCost}}{{else}}{{costLabel}}{{/if}} {{t "pts"}}{{/if}}</span></a>
            {{#if range}}<label class="cost">{{t "Cost"}} <input type="number" name="traitCost.{{k}}" value="{{chosenCost}}" min="{{min}}" max="{{max}}"></label>{{/if}}
            <p>{{desc}}</p>
            {{#if fxText.length}}<ul class="cr-fx">{{#each fxText}}<li>{{this}}</li>{{/each}}</ul>{{/if}}
            {{#each choices}}
              <div class="cr-choice">
                <span>{{label}}{{#if many}} ({{count}}/{{n}}){{/if}}</span>
                {{#if many}}
                  <div class="cr-chips">{{#each options}}<a class="chip {{#if sel}}on{{/if}}" data-action="toggleChoice" data-key="{{../key}}" data-id="{{../id}}" data-n="{{../n}}" data-v="{{v}}">{{label}}</a>{{/each}}</div>
                {{else}}
                  <select name="choice.{{key}}.{{id}}"><option value="">{{t "— choose —"}}</option>{{#each options}}<option value="{{v}}" {{#if sel}}selected{{/if}}>{{label}}</option>{{/each}}</select>
                {{/if}}
              </div>
            {{/each}}
          </li>
        {{/each}}
        </ul>
      </div>
    </div>
  {{/if}}

  {{!-- ================= 3. S.P.E.C.I.A.L. ================= --}}
  {{#if step.special}}
    <p class="cr-desc">{{t "Every attribute starts at 1. With creation points you can raise it by at most 8 (Luck by 9); the limit after all bonuses is 12. A value of 5 is average. The “Hindrances/traits” column comes from the effects of the chosen entries; “Other” is a manual adjustment."}} {{rule "tests/attributes"}}</p>
    <table class="foe-table cr-attrs">
      <thead><tr><th class="l">{{t "Attribute"}}</th><th>{{t "Base"}}</th><th>{{t "Points"}}</th><th>{{t "Race"}}</th><th title="{{t "From hindrances and traits"}}">{{t "Hindrances/traits"}}</th><th title="{{t "Manual adjustments (e.g. Elderly: +1 INT or CHA)"}}">{{t "col|Other"}}</th><th>{{t "Result"}}</th><th>MFD 1</th></tr></thead>
      <tbody>
      {{#each attrs}}
        <tr class="{{#if bad}}lethal{{/if}}">
          <td class="l">{{label}}</td>
          <td class="q">1</td>
          <td class="pm">
            <button type="button" data-action="attrMinus" data-key="{{key}}" {{#unless canMinus}}disabled{{/unless}}>−</button>
            <b>{{spent}}</b><span class="q">/{{maxSpent}}</span>
            <button type="button" data-action="attrPlus" data-key="{{key}}" {{#unless canPlus}}disabled{{/unless}}>+</button>
          </td>
          <td>{{racialLabel}}</td>
          <td>{{effLabel}}</td>
          <td><input type="number" name="adj.{{key}}" value="{{adj}}"></td>
          <td class="tn big">{{total}}</td>
          <td class="q">{{mfd}}</td>
        </tr>
      {{/each}}
      </tbody>
    </table>
  {{/if}}

  {{!-- ================= 4. UMIEJĘTNOŚCI ================= --}}
  {{#if step.skills}}
    <p class="cr-desc">{{{t "Starting rank = 2 × attribute + Luck/2 + 2 (min. 5). Choose <b>{n}</b> tagged skills (+15) — {k} chosen. The “Hindrances/traits” column is counted automatically from the effects. “Other” is extra ranks, e.g. the free ranks of a Canterlot ghoul." n=r.tagLimit k=r.tags.length}}} {{rule "tests/skills"}}</p>
    <div class="scroll-x">
    <table class="foe-table skills cr-skills">
      <thead><tr><th>Tag</th><th class="l">{{t "Skill"}}</th><th>{{t "Attr"}}</th><th>{{t "Base"}}</th><th>{{t "Race"}}</th><th>{{t "Hindrances/traits"}}</th><th>{{t "col|Other"}}</th><th>{{t "Rank"}}</th><th>MFD 1</th></tr></thead>
      <tbody>
      {{#each skills}}
        <tr class="{{#if racial}}racial{{/if}} {{#unless known}}unknown{{/unless}} {{#if tag}}tagged{{/if}}">
          <td>{{#if known}}<a class="tagbox {{#if tag}}on{{/if}} {{#unless canTag}}off{{/unless}}" data-action="toggleTag" data-key="{{key}}"></a>{{/if}}</td>
          <td class="l">{{label}}</td>
          <td>{{attrLabel}}</td>
          {{#if known}}
            <td class="q">{{base}}</td><td>{{raceLabel}}</td><td>{{effLabel}}</td>
            <td><input type="number" name="extra.{{key}}" value="{{extra}}"></td>
            <td><b>{{rank}}</b></td><td class="tn">{{tn}}</td>
          {{else}}
            <td colspan="6" class="q">{{t "not available to this race"}}</td>
          {{/if}}
        </tr>
      {{/each}}
      </tbody>
    </table>
    </div>
  {{/if}}

  {{!-- ================= 5. PODSUMOWANIE ================= --}}
  {{#if step.summary}}
    <dl class="derived cr-sum">
      <dt>{{t "Name"}}</dt><dd>{{st.name}}</dd>
      <dt>{{t "Race"}}</dt><dd>{{summary.race}}</dd>
      <dt>S.P.E.C.I.A.L.</dt><dd>{{summary.attrs}}</dd>
      <dt>{{t "Tags"}}</dt><dd>{{summary.tags}}</dd>
      <dt>{{t "Hindrances"}}</dt><dd>{{summary.hindrances}}</dd>
      <dt>{{t "Traits"}}</dt><dd>{{summary.traits}}</dd>
      {{#if summary.perk}}<dt>Perk</dt><dd>{{summary.perk}}</dd>{{/if}}
      <dt>{{t "SATS / luck cards"}}</dt><dd>{{summary.sats}} / {{summary.luckCards}}</dd>
      <dt>{{t "Damage per wound"}}</dt><dd>{{summary.wound}}</dd>
      <dt>{{t "Carry weight"}}</dt><dd>{{summary.carry}}</dd>
      <dt>{{t "Starting caps"}}</dt><dd>{{r.caps}}</dd>
      {{#if summary.karma}}<dt>Karma</dt><dd>{{summary.karma}}</dd>{{/if}}
    </dl>
    {{#if r.errors.length}}<h3>{{t "To fix"}}</h3><ul class="cr-msg bad">{{#each r.errors}}<li>{{this}}</li>{{/each}}</ul>{{/if}}
    {{#if r.warnings.length}}<h3>{{t "Remarks"}}</h3><ul class="cr-msg warn">{{#each r.warnings}}<li>{{this}}</li>{{/each}}</ul>{{/if}}
    {{#if overwrite}}<p class="hint">{{t "This character was already made with the creator — confirming will overwrite the attributes, skills and features from the creator."}}</p>{{/if}}
    <p class="hint">{{t "After creating: choose a cutie mark, spells or recipes (if the race has them) and equipment worth {caps} caps. Situational racial penalties (e.g. Speechcraft with ponies) are in the description of the “Race” feature." caps=r.caps}}</p>
  {{/if}}
  </div>

  <footer class="cr-foot">
    <button type="button" data-action="prev" {{#if isFirst}}disabled{{/if}}><i class="fa-solid fa-chevron-left"></i> {{t "nav|Back"}}</button>
    {{#if isLast}}
      <button type="button" class="primary" data-action="finish" {{#unless canFinish}}disabled{{/unless}}><i class="fa-solid fa-check"></i> {{t "Create character"}}</button>
    {{else}}
      <button type="button" class="primary" data-action="next">{{t "Next"}} <i class="fa-solid fa-chevron-right"></i></button>
    {{/if}}
  </footer>
</div>
