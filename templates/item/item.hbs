<div class="foe-item">
  <header class="foe-id">
    <img class="portrait" src="{{item.img}}" data-edit="img" data-action="editImage" alt="">
    <input class="name" type="text" name="name" value="{{item.name}}">
  </header>
  <div class="fields">
  {{#if isWeapon}}
    <label>{{t "Skill"}} <select name="system.skill">{{selectOptions skillOptions selected=system.skill}}</select></label>
    <label>{{t "col|Type"}} <select name="system.kind">{{selectOptions weaponKinds selected=system.kind}}</select></label>
    <label title="{{t "“STR” in the formula: melee = strength × multiplier from the Melee/Unarmed rank, bows and thrown = strength alone"}}">{{t "Damage (formula)"}} <input type="text" name="system.damage" value="{{system.damage}}" placeholder="3d4 + STR"></label>
    <label title="{{t "Weapons with “/N” in the table: a single shot uses that many rounds"}}">{{t "Burst (rounds per shot)"}} <input type="number" name="system.shots" value="{{system.shots}}" min="1"></label>
    <label title="{{t "Multiplier from the Crit column, e.g. x1.5"}}">{{t "label|Critical"}} <input type="text" name="system.crit" value="{{system.crit}}" placeholder="x1 / x1.5 / x2"></label>
    <label>{{t "SATS cost (AP)"}} <input type="number" name="system.satsCost" value="{{system.satsCost}}"></label>
    <label>{{t "Ammo in the magazine"}} <span class="pair"><input type="number" name="system.ammo.value" value="{{system.ammo.value}}"> / <input type="number" name="system.ammo.max" value="{{system.ammo.max}}"></span></label>
    <label title="{{t "Must match the name or ammo type in the inventory — then reloading deducts it"}}">{{t "Ammo type"}} <input type="text" name="system.ammoType" value="{{system.ammoType}}" placeholder="{{t "e.g. 10mm"}}"></label>
    <label title="DTM 10 AP, DTM+5 15, Revolver 20, Internal 20, Breech 25">{{t "Reload"}} <input type="text" name="system.reload" value="{{system.reload}}" list="foe-reload-types" placeholder="DTM / Revolver / Internal / Breech">
      <datalist id="foe-reload-types"><option value="DTM"><option value="DTM+5"><option value="Revolver"><option value="Internal"><option value="Breech"></datalist></label>
    <label title="{{t "Range increment in feet; each further increment = 1 MFD step harder. 0 = melee or computed from the description (e.g. (STR/2)×5 ft)"}}">{{t "Range increment (ft)"}} <input type="number" name="system.rangeInc" value="{{system.rangeInc}}" min="0"></label>
    <label>{{t "Range (description)"}} <input type="text" name="system.range" value="{{system.range}}" placeholder="{{t "e.g. (STR/2)×5 ft"}}"></label>
    <label title="{{t "Magical weapons (MFC, ME-Cell, Gem Cell) ignore 5 DT"}}">{{t "Ignores DT"}} <input type="number" name="system.ignoreDT" value="{{system.ignoreDT}}" min="0"></label>
    <label title="{{t "Mounted on a battle saddle: saddle weight limit, volley, reserves and loaders"}}">{{t "On a battle saddle"}} <input type="checkbox" name="system.mounted" {{checked system.mounted}}></label>
    <label title="{{t "Damage already includes bonuses (bestiary weapons) — the system adds nothing"}}">{{t "Damage without bonuses"}} <input type="checkbox" name="system.flat" {{checked system.flat}}></label>
    <label title="{{t "Ignores worn armor — only natural DT counts (e.g. Sonic Screech)"}}">{{t "Ignores armor"}} <input type="checkbox" name="system.armorless" {{checked system.armorless}}></label>
    <label>{{t "Area (explosion)"}} <input type="checkbox" name="system.aoe.enabled" {{checked system.aoe.enabled}}></label>
    {{#if system.aoe.enabled}}
    <label>{{t "Splash damage / radius"}} <span class="pair"><input type="text" name="system.aoe.splash" value="{{system.aoe.splash}}" placeholder="6d12"> <input type="text" name="system.aoe.radius" value="{{system.aoe.radius}}" placeholder="15 ft"></span></label>
    <label title="{{t "How many dice fewer for every further 5 ft from the center"}}">{{t "Falloff per 5 ft"}} <input type="text" name="system.aoe.inc" value="{{system.aoe.inc}}" placeholder="−2d12"></label>
    {{/if}}
  </div>
  <h3>{{t "Special effects"}}</h3>
  <div class="fields">
    <label>{{t "Fire"}} <select name="system.specials.fire">{{selectOptions hitModes selected=system.specials.fire}}</select></label>
    <label>{{t "Disintegration"}} <select name="system.specials.disintegrate">{{selectOptions hitModes selected=system.specials.disintegrate}}</select></label>
    <label>{{t "Poison"}} <select name="system.specials.poison">{{selectOptions poisons selected=system.specials.poison}}</select></label>
    <div class="cover-grid specials">
      {{#each specialChecks}}<label class="cover" title="{{desc}}"><input type="checkbox" name="system.specials.{{key}}" {{checked on}}> {{label}}</label>{{/each}}
    </div>
    <p class="hint">{{t "Fire, electricity, radiation, disintegration, stun, poison and knockdown work on “Apply damage” and at the end of the round. The rest are markers with a description (hover). Catalog weapons have them set from the rulebook's footnotes."}}</p>
  </div>
  <div class="fields">
    <label title="{{t "Grenades, mines: an attack uses up one"}}">{{t "Consumable (grenade, mine)"}} <input type="checkbox" name="system.consumable" {{checked system.consumable}}></label>
    {{#if system.consumable}}<label>{{t "Number of pieces"}} <input type="number" name="system.qty" value="{{system.qty}}" min="0"></label>{{/if}}
    <label title="{{t "(mw) in the table — can be held in the mouth"}}">{{t "Mouth-wielded (mw)"}} <input type="checkbox" name="system.mw" {{checked system.mw}}></label>
    <label title="{{t "Max. weapon weight = 2×STR; every started 2 lb over it is −1 MFD step"}}">{{t "Weight"}} <input type="number" step="0.1" name="system.weight" value="{{system.weight}}"></label>
    <label>{{t "Price (caps)"}} <input type="number" name="system.value" value="{{system.value}}" min="0"></label>
  {{/if}}
  {{#if isArmor}}
    <label>{{t "Category"}} <select name="system.category">{{selectOptions armorCats selected=system.category}}</select></label>
    <label>DT <input type="number" name="system.dt" value="{{system.dt}}" min="0"></label>
    <label>{{t "Worn"}} <input type="checkbox" name="system.equipped" {{checked system.equipped}}></label>
    <label>{{t "Power armor"}} <input type="checkbox" name="system.powered" {{checked system.powered}}></label>
    <label>{{t "Weight"}} <input type="number" step="0.1" name="system.weight" value="{{system.weight}}"></label>
    <label>{{t "Price (caps)"}} <input type="number" name="system.value" value="{{system.value}}" min="0"></label>
  {{/if}}
  {{#if isGear}}
    <label>{{t "Category"}} <select name="system.category">{{selectOptions gearCats selected=system.category}}</select></label>
    <label>{{t "Quantity"}} <input type="number" name="system.qty" value="{{system.qty}}"></label>
    <label>{{t "Weight (each)"}} <input type="number" step="0.1" name="system.weight" value="{{system.weight}}"></label>
    <label>{{t "Price (each)"}} <input type="number" name="system.value" value="{{system.value}}" min="0"></label>
    {{#if reserveGear}}
    <label title="{{t "Energy reserve: points (energy cell 2, MFC 4, gem cell 1); fuel reserve: fuel units"}}">{{t "Reserve contents"}} <input type="number" name="system.charges" value="{{system.charges}}" min="0"> / {{reserveCap}}</label>
    {{/if}}
    {{#if medGear}}
    <label>{{t "Healing type"}} <select name="system.heal">{{selectOptions healKinds selected=system.heal}}</select></label>
    <label title="{{t "Talismans: charged with a healing spell of level 2+ (rejuvenating: 3+)"}}">{{t "Charges"}} <input type="number" name="system.charges" value="{{system.charges}}" min="0"></label>
    {{/if}}
    {{#if zebraGear}}
    <label>{{t "Rarity"}} <select name="system.rarity" data-dtype="Number">{{selectOptions gearRarities selected=system.rarity}}</select></label>
    <label title="{{t "Drink, Throw, Apply or Worn"}}">{{t "Usage"}} <select name="system.usage">{{selectOptions usages selected=system.usage}}</select></label>
    <label title="{{t "Thrown potions"}}">{{t "Damage"}} <input type="text" name="system.damage" value="{{system.damage}}"></label>
    {{/if}}
    <label title="{{t "Weapons with the same ammo type load from this item"}}">{{t "Ammo type"}} <input type="text" name="system.ammoType" value="{{system.ammoType}}" placeholder="{{t "e.g. 10mm"}}"></label>
  {{/if}}
  {{#if isSpell}}
    <label title="{{t "Unicorns/alicorns pay strain, zebras — with ingredients"}}">{{t "Tradition"}} <select name="system.tradition">{{selectOptions traditions selected=system.tradition}}</select></label>
    <label>{{#if isRecipe}}{{t "Recipe level"}}{{else if isManeuver}}{{t "Maneuver level"}}{{else}}{{t "Spell level"}}{{/if}} <select name="system.level" data-dtype="Number">{{selectOptions spellLevels selected=system.level}}</select></label>
  {{/if}}
  {{#if isManeuver}}
    <label>{{t "MFD to perform"}} <select name="system.mfd">{{selectOptions mfdSteps selected=system.mfd}}</select></label>
    <label>{{t "col|Type"}} <select name="system.kind">{{selectOptions maneuverKinds selected=system.kind}}</select></label>
    <label title="{{t "An aerial dodge replaces the normal dodge"}}">{{t "Defense"}} <select name="system.tag">{{selectOptions maneuverTags selected=system.tag}}</select></label>
    <label title="{{t "0 = takes no action (e.g. Hover)"}}">{{t "Actions"}} <input type="number" name="system.actions" value="{{system.actions}}" min="0"></label>
    <label title="{{t "Mastered: a successful learning roll (with a 3 MFD step penalty)"}}">{{t "Mastered"}} <input type="checkbox" name="system.learned" {{checked system.learned}}></label>
    <label title="{{t "Learning attempt limit = character level"}}">{{t "Learning attempts used"}} <input type="number" name="system.attempts" value="{{system.attempts}}" min="0"></label>
    <label>{{t "Requirements"}} <input type="text" name="system.requires" value="{{system.requires}}"></label>
  {{/if}}
  {{#if isRecipe}}
    <label title="{{t "Drink, Throw, Apply, Worn, Cast — comma-separated"}}">{{t "Usage"}} <input type="text" name="system.usage" value="{{system.usage}}" placeholder="{{t "e.g. Drink, Throw"}}"></label>
    <label>{{t "Ingredient rarity"}} <select name="system.rarity" data-dtype="Number">{{selectOptions rarities selected=system.rarity}}</select></label>
    <label>{{t "Special ingredient"}} <input type="text" name="system.special" value="{{system.special}}"></label>
    <label>{{t "School"}} <input type="text" name="system.school" value="{{system.school}}"></label>
    <label title="{{t "For thrown potions and damaging rituals"}}">{{t "Damage (formula)"}} <input type="text" name="system.damage" value="{{system.damage}}"></label>
    <label>{{t "Required character level"}} <input type="number" name="system.levelReq" value="{{system.levelReq}}" min="0"></label>
  {{/if}}
  {{#if isUnicorn}}
    <label title="Low 1, Medium 2, High 3, Very High 4">{{t "Strain cost"}} <select name="system.cost" data-dtype="Number">{{selectOptions spellCosts selected=system.cost}}</select></label>
    <label title="{{t "0 = can't be cast in SATS"}}">{{t "SATS cost (AP)"}} <input type="number" name="system.satsCost" value="{{system.satsCost}}" min="0"></label>
    <label title="{{t "A second Magic roll to hit (range increment 20 ft)"}}">{{t "Targeted"}} <input type="checkbox" name="system.targeted" {{checked system.targeted}}></label>
    <label title="{{t "Cost paid at the start of every round"}}">{{t "Maintained"}} <input type="checkbox" name="system.maintained" {{checked system.maintained}}></label>
    <label title="{{t "INT = intelligence, MAGIC10 = Magic rank / 10"}}">{{t "Damage (formula)"}} <input type="text" name="system.damage" value="{{system.damage}}" placeholder="{{t "e.g. 1d12 or 3d8 + INT"}}"></label>
    <label>{{t "label|Critical"}} <input type="text" name="system.crit" value="{{system.crit}}" placeholder="x1"></label>
    <label>{{t "Ignores DT"}} <input type="number" name="system.ignoreDT" value="{{system.ignoreDT}}" min="0"></label>
    <label>{{t "Learning percentage"}} <input type="number" name="system.learn" value="{{system.learn}}" min="0" max="95"></label>
    <label>{{t "Required character level"}} <input type="number" name="system.levelReq" value="{{system.levelReq}}" min="0"></label>
    <label>{{t "Requirements"}} <input type="text" name="system.requirements" value="{{system.requirements}}"></label>
    <label>{{t "Precursors"}} <input type="text" name="system.precursors" value="{{system.precursors}}"></label>
    <label>{{t "Precursor for"}} <input type="text" name="system.precursorFor" value="{{system.precursorFor}}"></label>
  {{/if}}
  {{#if isFeature}}
    <label>{{t "col|Type"}} <select name="system.kind">{{selectOptions featureKinds selected=system.kind}}</select></label>
    <label>{{t "Active (effects applied)"}} <input type="checkbox" name="system.active" {{checked system.active}}></label>
    {{#if isCyber}}
    <label title="{{t "Cyberlimb location (without power it works as crippled)"}}">{{t "Location"}} <select name="system.cyber.loc">{{selectOptions cyberLocs selected=system.cyber.loc}}</select></label>
    <label title="{{t "Power usage: limb 1, torso 2, implant ¼ (0 = needs none)"}}">{{t "Power usage"}} <input type="number" name="system.cyber.power" value="{{system.cyber.power}}" min="0" step="0.25"></label>
    <label title="{{t "Scrap repairs 1 wound per 15 minutes on the cyberlimb's location"}}">{{t "Repair talisman"}} <input type="checkbox" name="system.cyber.talisman" {{checked system.cyber.talisman}}></label>
    <label title="{{t "Regeneration: 1 wound every this many seconds (3600 = Phoenix Monocyte Breeder); 0 = none"}}">{{t "Regeneration (s/wound)"}} <input type="number" name="system.cyber.regen" value="{{system.cyber.regen}}" min="0"></label>
    <label title="{{t "Internal energy reservoir in points (cell 2, MFC 4, gem cell 1)"}}">{{t "Energy reservoir"}} <input type="number" name="system.cyber.charges" value="{{system.cyber.charges}}" min="0"> / <input type="number" name="system.cyber.capacity" value="{{system.cyber.capacity}}" min="0"></label>
    {{/if}}
  {{/if}}
  </div>
  {{#if isArmor}}
  <h3>{{t "Covers"}}</h3>
  <div class="cover-grid">
    {{#each coverRows}}<label class="cover"><input type="checkbox" name="system.cover.{{key}}" {{checked on}}> {{label}}</label>{{/each}}
  </div>
  {{#if wearRows.length}}
  <div class="wear-row"><span title="{{t "Degradation (optional rule): this much less DT on the location. Reset after repair."}}">{{t "DT wear:"}}</span>
    {{#each wearRows}}<label>{{label}} <input type="number" name="system.wear.{{key}}" value="{{wear}}" min="0"></label>{{/each}}
  </div>
  {{/if}}
  <p class="hint">{{t "Bardings usually cover the torso and four legs, helmets the head; wings only with “Wing Covers”, the horn almost never. On the character sheet the highest DT among worn armor on a given location counts."}}</p>
  {{/if}}
  {{#if hasFx}}
  <h3>{{t "Effects"}} <a data-action="addFx" title="{{t "Add effect"}}"><i class="fa-solid fa-plus"></i></a></h3>
  <p class="hint">{{#if isArmor}}{{t "They work while the armor is worn. Attribute bonuses from armor are “Temporary attribute change”."}} {{/if}}{{t "An effect without a condition always works. One with a condition (“when”) appears in the roll window as a checkbox. A positive value makes it easier (bonus), a negative one harder."}}</p>
  <table class="foe-table fx-edit">
    <thead><tr><th class="l">{{t "What it changes"}}</th><th class="l">{{t "Applies to"}}</th><th>{{t "Value"}}</th><th class="l">{{t "When (situation)"}}</th><th></th></tr></thead>
    <tbody>
    {{#each fxRows}}
      <tr>
        <td class="l"><select data-fx-i="{{i}}" data-fx-field="type">{{#each types}}<option value="{{v}}" {{#if sel}}selected{{/if}}>{{label}}</option>{{/each}}</select></td>
        <td class="l"><select data-fx-i="{{i}}" data-fx-field="target">
          {{#if custom}}<option value="{{custom.v}}" selected>{{custom.label}}</option>{{/if}}
          {{#each groups}}<optgroup label="{{label}}">{{#each opts}}<option value="{{v}}" {{#if sel}}selected{{/if}}>{{label}}</option>{{/each}}</optgroup>{{/each}}
        </select></td>
        <td><input type="number" data-fx-i="{{i}}" data-fx-field="value" value="{{value}}"></td>
        <td class="l"><input type="text" data-fx-i="{{i}}" data-fx-field="when" value="{{when}}" placeholder="{{t "fx|always"}}"></td>
        <td class="ctl"><a data-action="removeFx" data-i="{{i}}" title="{{t "Delete"}}"><i class="fa-solid fa-trash"></i></a></td>
      </tr>
    {{else}}<tr><td colspan="5" class="empty">{{t "No effects — description only."}}</td></tr>
    {{/each}}
    </tbody>
  </table>
  {{/if}}
  <prose-mirror name="system.description" toggled value="{{system.description}}">{{{descHTML}}}</prose-mirror>
</div>
