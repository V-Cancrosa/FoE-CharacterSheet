<section class="tab active vehicle-body">
  <header class="foe-header">
    <div class="pip-bar"><span>PIPBUCK 3000 · {{t "VEHICLE REGISTRY"}}</span><span>{{#if stats.dead}}{{t "WRECK"}}{{else}}{{t "VEHICLE"}}{{/if}}</span></div>
    <div class="foe-id">
      <img class="portrait" src="{{actor.img}}" data-action="portrait" alt="{{actor.name}}">
      <div class="identity">
        <input class="name" type="text" name="name" value="{{actor.name}}" placeholder="{{t "Vehicle name"}}">
        <div class="row veh-row">
          <label>{{t "col|Type"}} <select name="system.vehicle.kind">{{#each kinds}}<option value="{{value}}" {{#if sel}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
          <label>{{t "Propulsion"}} <select name="system.vehicle.power">{{#each powers}}<option value="{{value}}" {{#if sel}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
        </div>
        <div class="row veh-row">
          <label class="wide" title="{{t "Table XLI (p. 608): size relative to a pony sets damage per wound and hitting"}}">{{t "Size"}} <select name="system.vehicle.size">{{#each sizes}}<option value="{{value}}" {{#if sel}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
        </div>
      </div>
    </div>
  </header>

  <div class="status-bar">
    <span class="cs" title="{{t "Damage per wound from table XLI"}}">D/W <b>{{stats.dw}}</b></span>
    <span class="cs" title="{{t "How many wounds destroy an area (half: damaged)"}}">{{t "Durability"}} <b>{{stats.structure}}</b> · {{t "dmg. from {n}" n=stats.crippleAt}}</span>
    <span class="cs" title="{{#each stats.speedNotes}}{{this}}&#10;{{/each}}">{{t "Speed"}} <b>{{stats.speed}}</b> {{t "ft/action"}}</span>
    <label class="cs alt" title="{{t "Current speed in ft per round: counts for crashes and shots on the move"}}">{{t "Moving"}} <input type="number" name="system.vehicle.currentSpeed" value="{{v.currentSpeed}}" min="0" step="5"> ft</label>
    {{#if sky}}<label class="cs alt" title="{{t "Flight altitude: with destroyed propulsion the vehicle falls"}}">{{t "Alt."}} <input type="number" name="system.altitude" value="{{system.altitude}}" min="0" step="5"> ft</label>{{/if}}
    {{#if stats.hitSteps}}<span class="cs" title="{{t "Large target: easier to hit (table XLI)"}}">{{t "To hit"}} <b>+{{stats.hitSteps}}</b> {{t "st."}}</span>{{/if}}
    {{#if stats.dodge}}<span class="cs" title="{{t "Large vehicle: evasive maneuver {n} MFD step" n=stats.dodge}}">{{t "Dodge"}} <b>{{stats.dodge}}</b> {{t "st."}}</span>{{/if}}
    {{#if stats.evasive}}<a class="cs act" data-action="clearEvasive" title="{{t "Evasive maneuver active: attacks on the vehicle −{n} st. Click to end it" n=stats.evasive}}">{{t "Evading"}} <b>−{{stats.evasive}}</b> {{t "st."}} <i class="fa-solid fa-xmark"></i></a>{{/if}}
    {{#if stats.dead}}<span class="cs alert">{{t "WRECK"}}</span>{{/if}}
    {{#if stats.falling}}<span class="cs alert">{{t "FALLING"}}</span>{{/if}}
  </div>
  {{#if stats.speedNotes.length}}<p class="hint">{{#each stats.speedNotes}}{{this}}{{#unless @last}} · {{/unless}}{{/each}}</p>{{/if}}

  <div class="veh-actions">
    <a data-action="drive" title="{{t "Steering roll: evasive maneuver, chase, rough terrain, regaining control"}}"><i class="fa-solid fa-dharmachakra"></i> {{t "Steer"}}</a>
    <a data-action="ram" title="{{t "Ram the targeted (T) target: 1d20 per 20 ft of speed"}}"><i class="fa-solid fa-truck-monster"></i> {{t "Ram"}}</a>
    <a data-action="crash" title="{{t "Crash into an obstacle or a fall: damage to the vehicle and the crew"}}"><i class="fa-solid fa-car-burst"></i> {{t "Crash"}}</a>
    <a data-action="repair" title="{{t "Repair an area: Repair roll, uses scrap"}}"><i class="fa-solid fa-screwdriver-wrench"></i> {{t "btn|Fix"}}</a>
    <a data-action="rollInitiative" title="{{t "Add the vehicle to the combat (initiative from the vehicle crew's AGI)"}}"><i class="fa-solid fa-dice-d20"></i> {{t "Initiative"}}</a>
  </div>
  <p class="hint">{{t "Steering: {name}" name=stats.pilot}} ({{stats.pilotSkill}}). {{t "Every crew member acts in their own turn with their own actions; gunners use the mounted weapons from this sheet."}}</p>

  <h3>{{t "Areas"}}</h3>
  <table class="foe-table veh-areas">
    <thead><tr><th class="l">{{t "Area"}}</th><th title="{{t "MFD of a called shot at the area"}}">MFD</th><th title="{{t "Vehicle armor (natural DT — doesn't degrade)"}}">DT</th><th>{{t "Wounds"}}</th><th class="l">{{t "Status"}}</th></tr></thead>
    <tbody>
    {{#each areas}}
      <tr class="{{cls}}">
        <td class="l"><b>{{label}}</b></td>
        <td>{{mfd}}</td>
        <td><input type="number" name="system.locations.{{key}}.dt" value="{{dt}}" min="0"></td>
        <td class="nw"><input type="number" name="system.locations.{{key}}.wounds" value="{{wounds}}" min="0"> / {{limit}}</td>
        <td class="l">{{#if statusText}}<b>{{statusText}}</b>{{/if}}{{#if effect}} <small>{{effect}}</small>{{/if}}</td>
      </tr>
    {{/each}}
    </tbody>
  </table>
  <p class="hint">{{t "An attack on a vehicle shows these areas instead of pony locations. Random hit (d20): 1–2 cabin, 3–14 hull, 15–18 propulsion, 19–20 armament. A destroyed hull = a wreck."}}</p>

  <h3>{{t "Mounted weapons"}}
    <a data-action="openCatalog" data-tab="weapons" title="{{t "Weapon catalog from the rulebook (e.g. IF-2200 MBT Primary Cannon, AER-20 Magical Gatling Laser)"}}"><i class="fa-solid fa-boxes-stacked"></i> {{t "Catalog"}}</a>
    <a class="plus" data-action="createItem" data-type="weapon" title="{{t "Blank weapon to fill in"}}"><i class="fa-solid fa-plus"></i></a>
  </h3>
  {{#if gunsDown}}<p class="hint warn">{{t "Armament destroyed — the weapons can't fire until the area is repaired."}}</p>{{else if gunSteps}}<p class="hint warn">{{t "Armament damaged: {n} MFD steps to shots." n=gunSteps}}</p>{{/if}}
  <div class="scroll-x">
  <table class="foe-table items weapons">
    <thead><tr><th></th><th class="l">{{t "col|Name"}}</th><th class="hide-narrow">{{t "Skill"}}</th><th>{{t "Damage"}}</th><th>{{t "Crit."}}</th><th>SATS</th><th>{{t "Ammo"}}</th><th>{{t "Range"}}</th><th></th></tr></thead>
    <tbody>
    {{#each weapons}}
      <tr data-item-id="{{id}}">
        <td><img class="icon" src="{{img}}" alt=""></td>
        <td class="l"><a class="rollable" data-action="fireWeapon" title="{{t "Shot: choose a gunner from the crew"}}">{{name}}</a>{{#if tags.length}}<div class="wtags">{{#each tags}}<span title="{{tip}}">{{label}}</span>{{/each}}</div>{{/if}}</td>
        <td class="hide-narrow">{{skillLabel}}</td>
        <td class="nw"><a class="rollable" data-action="rollDamage" title="{{t "Damage only (Shift+click: critical)"}}">{{damage}}</a>{{#if burst}}<small class="sub">/{{burst}}</small>{{/if}}</td>
        <td>{{crit}}</td>
        <td>{{satsCost}}</td>
        <td class="nw ammo">{{#if ammo.max}}<b>{{ammo.value}}/{{ammo.max}}</b> <a class="reload" data-action="reload" title="{{t "Reload ({r})" r=reloadLabel}}"><i class="fa-solid fa-rotate"></i></a>{{#if ammoType}}<small class="sub">{{ammoType}}</small>{{/if}}{{else}}—{{/if}}</td>
        <td class="nw">{{rangeLabel}}</td>
        <td class="ctl"><a data-action="editItem" title="{{t "Edit"}}"><i class="fa-solid fa-pen"></i></a> <a data-action="deleteItem" title="{{t "Delete"}}"><i class="fa-solid fa-trash"></i></a></td>
      </tr>
    {{else}}<tr><td colspan="9" class="empty">{{t "No mounted weapons — add them from the catalog or with the plus."}}</td></tr>
    {{/each}}
    </tbody>
  </table>
  </div>
  <p class="hint">{{t "A crew member fires with their own skill and their own AP in SATS; the weapon's weight gives no penalties. A shot from a moving vehicle: −1 step (can be unchecked in the attack window)."}}</p>

  <h3>{{t "Crew"}}
    <a data-action="addCrew" title="{{t "Add the selected character tokens (or your character)"}}"><i class="fa-solid fa-user-plus"></i> {{t "Add"}}</a>
  </h3>
  <ul class="item-list veh-crew">
    {{#each crew}}
    <li data-crew="{{index}}" class="{{#if missing}}warn{{/if}}">
      <img class="icon" src="{{img}}" alt="">
      <a class="nm" data-action="openCrew" title="{{t "Open the sheet"}}">{{name}}</a>
      <select data-crew-index="{{index}}">{{#each roles}}<option value="{{value}}" {{#if sel}}selected{{/if}}>{{label}}</option>{{/each}}</select>
      <span class="cdesc">{{info}}</span>
      <span class="ctl"><a data-action="removeCrew" title="{{t "Remove from the crew"}}"><i class="fa-solid fa-user-minus"></i></a></span>
    </li>
    {{else}}<li class="empty">{{t "No crew — drag a character from the actors tab onto this sheet or select its token and click “Add”. Without a crew the vehicle steers and fires with the statistics from the “Nameless crew” section."}}</li>
    {{/each}}
  </ul>
  {{#if crewWarnings.length}}<p class="hint warn">{{#each crewWarnings}}{{this}}{{#unless @last}} · {{/unless}}{{/each}}</p>{{/if}}

  <h3>{{t "Parameters"}}</h3>
  <div class="veh-params">
    {{#unless pulled}}<label title="{{t "Self-propelled: ft per action"}}">{{t "Speed"}} <input type="number" name="system.vehicle.speed" value="{{v.speed}}" min="0" step="5"></label>{{/unless}}
    {{#if pulled}}<label title="{{t "How many ponies the harness holds"}}">{{t "Harness"}} <input type="number" name="system.vehicle.harness" value="{{v.harness}}" min="0"></label>{{/if}}
    <label title="{{t "MFD steps to steering (+ easier, − harder)"}}">{{t "Handling"}} <input type="number" name="system.vehicle.handling" value="{{v.handling}}"></label>
    <label>{{t "Steering"}} <select name="system.vehicle.pilotSkill">{{#each pilotOptions}}<option value="{{value}}" {{#if sel}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
    <label title="{{t "Driver and gunners"}}">{{t "Crew"}} <input type="number" name="system.vehicle.crewMax" value="{{v.crewMax}}" min="0"></label>
    <label>{{t "Passengers"}} <input type="number" name="system.vehicle.passengers" value="{{v.passengers}}" min="0"></label>
    <label title="{{t "Capacity in lb"}}">{{t "Cargo"}} <input type="number" name="system.vehicle.cargo" value="{{v.cargo}}" min="0"></label>
    <label title="{{t "How many wounds destroy an area; 0 = default {n} (5 + 1 per size doubling)" n=stats.defaultStructure}}">{{t "Durability"}} <input type="number" name="system.woundLimits.maim" value="{{system.woundLimits.maim}}" min="0"></label>
    <label title="{{t "From how many wounds an area is damaged; 0 = half the durability"}}">{{t "Damaged from"}} <input type="number" name="system.woundLimits.cripple" value="{{system.woundLimits.cripple}}" min="0"></label>
    <label title="{{t "Extra damage per wound (e.g. a reinforced hull)"}}">D/W ± <input type="number" name="system.woundBonus" value="{{system.woundBonus}}"></label>
  </div>

  <h3>{{t "Nameless crew"}} <small>{{t "vehicle statistics for stations without a character"}}</small></h3>
  <div class="veh-params veh-attrs">
    {{#each attrs}}<label title="{{title}}">{{label}} <input type="number" name="system.attributes.{{key}}.value" value="{{value}}" min="0" max="30"></label>{{/each}}
  </div>
  <div class="veh-params veh-attrs">
    {{#each crewSkills}}<label title="{{t "Target number at MFD 1: {n}; the field is skill points" n=tn}}">{{label}} <b>{{tn}}</b> <input type="number" name="system.skills.{{key}}.points" value="{{points}}"></label>{{/each}}
  </div>

  <h3>{{t "Cargo"}} <small>{{stats.weight}} / {{stats.carry}} lb</small>
    <a data-action="openCatalog" data-tab="gear" title="{{t "Gear catalog"}}"><i class="fa-solid fa-boxes-stacked"></i> {{t "Catalog"}}</a>
    <a class="plus" data-action="createItem" data-type="gear" title="{{t "New item"}}"><i class="fa-solid fa-plus"></i></a>
  </h3>
  <ul class="item-list veh-cargo">
    {{#each cargo}}
    <li data-item-id="{{id}}"><img class="icon" src="{{img}}" alt=""><span class="nm">{{name}}</span><span class="cdesc">×{{qty}} · {{weight}} lb</span>
      <span class="ctl"><a data-action="giveItem" title="{{t "Give from the hold to someone next to the vehicle or from the crew"}}"><i class="fa-solid fa-hand-holding"></i></a> <a data-action="editItem" title="{{t "Edit"}}"><i class="fa-solid fa-pen"></i></a> <a data-action="deleteItem" title="{{t "Delete"}}"><i class="fa-solid fa-trash"></i></a></span></li>
    {{else}}<li class="empty">{{t "Empty. Scrap (Scrap Metal / Electronics) in the cargo will come in handy for repairs."}}</li>
    {{/each}}
  </ul>

  <h3>{{t "Notes"}}</h3>
  <prose-mirror name="system.notes" toggled value="{{system.notes}}">{{{notesHTML}}}</prose-mirror>
  <p class="hint">{{t "The v1.22 rulebook has no chapter on vehicles. From the book come the size table XLI, crashes (1d20 per 20 ft of speed), harness speed by the slowest pony and aiming explosions directly at vehicles. Areas, steering, ramming and repair are house rules (described in the README)."}}</p>
</section>
