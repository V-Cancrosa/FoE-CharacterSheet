<section class="tab {{tab.cssClass}}" data-group="primary" data-tab="notes">
  <h3>{{t "Traits, hindrances, perks, spells"}}
    <a data-action="openCatalog" data-tab="perks" title="{{t "Perks from the rulebook (requirements are checked automatically)"}}"><i class="fa-solid fa-medal"></i> {{t "Perks"}}</a>
    <a data-action="levelUp" title="{{t "Level up: skill points and a perk"}}"><i class="fa-solid fa-arrow-up"></i> {{t "Level up"}}</a>
    <a class="plus" data-action="createItem" data-type="feature" title="{{t "Add"}}"><i class="fa-solid fa-plus"></i></a></h3>
  <ul class="item-list features">
  {{#each features}}
    <li data-item-id="{{id}}" class="{{#unless active}}inactive{{/unless}}">
      <div class="feat-row">
        <a class="feat-toggle {{#if active}}on{{/if}}" data-action="toggleFeature" title="{{#if active}}{{t "Active — click to turn the effects off"}}{{else}}{{t "Off — click to turn on"}}{{/if}}"></a>
        <span class="nm">{{name}}</span> <span class="kind">{{kindLabel}}</span>
        <span class="ctl"><a data-action="editItem" title="{{t "Edit"}}"><i class="fa-solid fa-pen"></i></a> <a data-action="deleteItem" title="{{t "Delete"}}"><i class="fa-solid fa-trash"></i></a></span>
      </div>
      {{#if fx.length}}<ul class="feat-fx">{{#each fx}}<li class="{{#if when}}sit{{/if}}">{{text}}</li>{{/each}}</ul>{{/if}}
    </li>
  {{else}}<li class="empty">{{t "None — add a trait, a hindrance or a perk."}}</li>{{/each}}
  </ul>
  <p class="hint">{{t "Effects of active features are counted automatically. Situational ones (with “when”) are checked in the roll window. The square on the left turns the whole feature off."}}</p>
  <h3>{{t "Notes"}}</h3>
  <prose-mirror name="system.notes" toggled value="{{system.notes}}">{{{notesHTML}}}</prose-mirror>
</section>
