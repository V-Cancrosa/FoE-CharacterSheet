<section class="tab {{tab.cssClass}}" data-group="primary" data-tab="combat">
  <div class="status-bar">
    <span class="cs" title="Action Points w SATS: 40 + 5×AGI; w walce +5 na rundę">SATS <b>{{system.resources.sats.value}}/{{system.resources.sats.max}}</b> AP</span>
    <span class="cs" title="4×END ran łącznie = utrata przytomności">Rany <b>{{system.totalWounds}}</b>/{{system.unconsciousAt}}</span>
    <span class="cs">Obrażenia na ranę <b>{{system.dmgPerWound}}</b></span>
    <a class="cs act" data-action="rollInitiative" title="Dołącz do walki na tej scenie i rzuć inicjatywę (d100 ± AGI ¼; niżej = szybciej)"><i class="fa-solid fa-dice-d20"></i> Inicjatywa</a>
    <span class="cs">Ruch <b>{{system.speed}}</b> ft</span>
    {{#if system.flier}}<span class="cs" title="Lot: 5×AGI ft na akcję">Lot <b>{{#if system.canFly}}{{system.flySpeed}} ft{{else}}{{system.flyNote}}{{/if}}</b>{{#if system.altitude}} · wys. {{system.altitude}} ft{{/if}}</span>{{/if}}
    <span class="cs" title="Pogoda (ustawia MG w zakładce walki): {{weather.summary}}"><i class="fa-solid fa-cloud-sun-rain"></i> {{weather.label}}</span>
    <a class="cs act" data-action="rollFall" title="Obrażenia od upadku: 1d20 na 10 ft, ignorują DT pancerza"><i class="fa-solid fa-person-falling"></i> Upadek</a>
    {{#if system.dead}}<span class="cs alert">MARTWY</span>{{else if system.unconsciousRisk}}<span class="cs alert">TRACI PRZYTOMNOŚĆ — rzut END ¾ przy każdej akcji</span>{{/if}}
  </div>

  <h3>Broń
    {{#if saddle.canVolley}}<a data-action="fireVolley" title="Wszystkie zamontowane bronie jedną akcją: −{{saddle.volleySteps}} {{saddle.stepsWord}} MFD; SATS: najdroższa broń +{{saddle.volleyAp}} AP"><i class="fa-solid fa-burst"></i> Salwa z siodła</a>{{/if}}
    <a data-action="openCatalog" data-tab="weapons" title="Katalog broni z podręcznika"><i class="fa-solid fa-boxes-stacked"></i> Katalog</a>
    <a class="plus" data-action="createItem" data-type="weapon" title="Pusta broń do uzupełnienia"><i class="fa-solid fa-plus"></i></a>
  </h3>
  {{#if saddle}}<p class="hint saddle-line"><b>{{saddle.label}}</b>{{#if saddle.builtIn}} (wbudowane: {{saddle.source}}){{/if}} · broń {{saddle.count}}/{{saddle.max}} · waga {{saddle.weight}}{{#if saddle.combined}}/{{saddle.combined}}{{/if}} lb · jedna broń do {{saddle.indiv}} lb{{#if saddle.acc}} · {{saddle.acc}}{{/if}}
    {{#each saddle.warnings}}<br><span class="warn">{{this}}</span>{{/each}}</p>{{/if}}
  <div class="scroll-x">
  <table class="foe-table items weapons">
    <thead><tr><th></th><th class="l">Nazwa</th><th class="hide-narrow">Umiejętność</th><th>Obrażenia</th><th title="Mnożnik krytyka">Kryt.</th><th title="Koszt ataku w SATS (AP)">SATS</th><th>Amunicja</th><th>Zasięg</th><th></th></tr></thead>
    <tbody>
    {{#each weapons}}
      <tr data-item-id="{{id}}">
        <td><img class="icon" src="{{img}}" alt=""></td>
        <td class="l">{{#if canMount}}<a class="mount-toggle {{#if mounted}}on{{/if}}" data-action="toggleMount" title="{{#if mounted}}Na siodle bojowym — kliknij, by zdjąć{{else}}Zamontuj na siodle bojowym{{/if}}">S</a> {{/if}}<a class="rollable" data-action="rollWeapon" title="Atak: okno z SATS, odległością i celem">{{name}}</a>{{#if cond}} <small class="sub {{#if cond.bad}}warn{{/if}}" title="Degradacja (s. 458): kroki = kości obrażeń">stan {{cond.left}}/{{cond.total}}</small>{{#if cond.worn}} <a class="repair" data-action="fixWeapon" title="Naprawa: Repair wg tabeli XXIX + broń-dawca na części"><i class="fa-solid fa-screwdriver-wrench"></i></a>{{/if}}{{/if}}{{#if tags.length}}<div class="wtags">{{#each tags}}<span title="{{tip}}">{{label}}</span>{{/each}}</div>{{/if}}</td>
        <td class="hide-narrow">{{skillLabel}}</td>
        <td class="nw"><a class="rollable" data-action="rollDamage" title="Same obrażenia (Shift+klik: krytyk)">{{damage}}</a>{{#if burst}}<small class="sub">/{{burst}}</small>{{/if}}</td>
        <td>{{crit}}</td>
        <td>{{satsCost}}</td>
        <td class="nw ammo">
          {{#if consumable}}<b>×{{qty}}</b>
          {{else if ammo.max}}<b>{{ammo.value}}/{{ammo.max}}</b> <a class="reload" data-action="reload" title="Przeładuj ({{reloadLabel}})"><i class="fa-solid fa-rotate"></i></a>{{#if ammoType}}<small class="sub">{{ammoType}}{{#if ammoVariant}} · <b title="{{ammoVariantTip}}">{{ammoVariant}}</b>{{/if}}</small>{{/if}}
          {{else}}—{{/if}}
        </td>
        <td class="nw" {{#if rangeTip}}title="{{rangeTip}}"{{/if}}>{{rangeLabel}}</td>
        <td class="ctl">{{#if canName}}<a data-action="nameItem" title="Broń nazwana (s. 204–206): 1+1d4 pkt na obrażenia, magazynek, SATS, efekty"><i class="fa-solid fa-star"></i></a> {{/if}}{{#if named}}<i class="fa-solid fa-star named-mark" title="Broń nazwana"></i> {{/if}}<a data-action="editItem" title="Edytuj"><i class="fa-solid fa-pen"></i></a> <a data-action="deleteItem" title="Usuń"><i class="fa-solid fa-trash"></i></a></td>
      </tr>
    {{else}}<tr><td colspan="9" class="empty">Brak broni — wybierz ją z katalogu albo dodaj plusem.</td></tr>
    {{/each}}
    </tbody>
  </table>
  </div>
  <p class="hint">Kliknij nazwę broni, by zaatakować: w oknie zaznaczysz SATS (zużywa AP i znosi kary otoczenia), odległość, strzał celowany albo losową lokację. Atak sam odejmie amunicję, a karta trafienia ma przyciski obrażeń i nanoszenia ran.</p>

  {{#if conditions.length}}
  <h3>Stany <a data-action="endRound" title="Zastosuj efekty końca rundy teraz (w walce dzieje się to samo przy zmianie rundy)"><i class="fa-solid fa-hourglass-end"></i> Koniec rundy</a></h3>
  <ul class="item-list conditions">
    {{#each conditions}}
    <li data-cond="{{key}}"><span class="nm">{{label}}</span><span class="cdesc">{{detail}}</span>
      <span class="ctl">
        {{#if extinguish}}<a data-action="extinguish" title="Rzut AGI ½ (2 akcje)"><i class="fa-solid fa-fire-extinguisher"></i> Ugaś</a>{{/if}}
        {{#if resist}}<a data-action="resistParalysis" title="Rzut END ½"><i class="fa-solid fa-dice-d20"></i> Rzut END</a>{{/if}}
        <a data-action="clearCondition" title="Usuń (antidotum, leczenie, decyzja MG)"><i class="fa-solid fa-xmark"></i></a>
      </span></li>
    {{/each}}
  </ul>
  {{/if}}

  <h3>Zdrowie, chemia i promieniowanie
    <a data-action="rest" title="Naturalne leczenie: 1 rana na lokację za 8 h (MG przesuwa czas gry)"><i class="fa-solid fa-bed"></i> Odpoczynek</a>
    <a data-action="setLimb" title="Nastawienie okaleczonej kończyny: Medicine ¾"><i class="fa-solid fa-bone"></i> Nastaw</a>
  </h3>
  {{#if body.any}}
  <ul class="item-list conditions body">
    {{#if body.rad}}<li><span class="nm">Promieniowanie</span><span class="cdesc">{{body.rad}}: {{body.radFx}}</span></li>{{/if}}
    {{#each body.active}}
    <li data-chem="{{id}}"><span class="nm">{{name}}</span><span class="cdesc">{{fx}}{{#if note}} · {{note}}{{/if}}{{#if left}} · zostało {{left}}{{/if}}</span>
      <span class="ctl"><a data-action="endChem" title="Zakończ działanie"><i class="fa-solid fa-xmark"></i></a></span></li>
    {{/each}}
    {{#each body.addictions}}
    <li data-group="{{group}}" class="{{#if on}}alert{{/if}}"><span class="nm">Uzależnienie: {{group}}</span>
      <span class="cdesc">{{#if on}}ODSTAWIENIE: {{withdrawal}}{{else}}złagodzone (działa środek z grupy albo Fixer){{/if}}{{#if long}} · ponad miesiąc — tylko detoks{{/if}}</span>
      <span class="ctl"><a data-action="cureAddiction" title="Wylecz (Cleanse Poison, wywar zebr, talizman, detoks)"><i class="fa-solid fa-xmark"></i></a></span></li>
    {{/each}}
  </ul>
  {{else}}<p class="hint">Bez działających środków, uzależnień i choroby popromiennej. Leki i chemię zażywasz przyciskiem „Użyj” w Ekwipunku.</p>{{/if}}

  {{#if cyber.show}}
  <h3>Cybernetyka
    <a data-action="feedCyber" title="Zjedz klejnot: zasilanie protez i implantów (s. 178)"><i class="fa-solid fa-gem"></i> Zasilanie</a>
    {{#if cyber.regen}}<a data-action="selfRepair" title="Talizman naprawczy (złom, 1 rana / 15 min) i regeneracja implantów"><i class="fa-solid fa-screwdriver-wrench"></i> Samonaprawa</a>{{/if}}
    <a data-action="openCatalog" data-tab="cyber" title="Implanty i protezy z podręcznika"><i class="fa-solid fa-microchip"></i> Katalog</a>
  </h3>
  <p class="hint cyber-line">Zużycie: <b>{{cyber.units}}</b> jedn.{{#if cyber.tracked}} · {{#if cyber.powered}}zasilanie jeszcze <b>{{cyber.hoursLeft}} h</b>{{else}}<span class="warn">BEZ ZASILANIA — implanty nie działają{{#if cyber.offline}}, protezy jak okaleczone: {{cyber.offline}}{{/if}}</span>{{/if}}{{else}} · zasilanie nie jest śledzone (ustawienie świata){{/if}}</p>
  <ul class="item-list cyber">
    {{#each cyber.items}}
    <li data-item-id="{{id}}" class="{{#unless active}}inactive{{/unless}}">
      <img class="icon" src="{{img}}" alt="">
      <span class="nm">{{name}}</span>
      <span class="cdesc">{{kindLabel}}{{#if loc}} · {{loc}}{{/if}}{{#if fx}} · {{fx}}{{/if}}{{#if talisman}} · talizman naprawczy{{/if}}{{#if reservoir}} · magazyn {{reservoir}} pkt{{/if}}</span>
      <span class="ctl">
        {{#if reservoir}}<a data-action="chargeReservoir" title="Przelej ogniwa z ekwipunku"><i class="fa-solid fa-bolt"></i></a>{{/if}}
        <a data-action="toggleFeature" title="Włącz / wyłącz"><i class="fa-solid fa-power-off"></i></a>
        <a data-action="editItem" title="Edytuj"><i class="fa-solid fa-pen"></i></a>
        <a data-action="deleteItem" title="Usuń"><i class="fa-solid fa-trash"></i></a>
      </span>
    </li>
    {{else}}<li class="empty">Cecha Cyberpony bez osobnych protez — dodaj je z katalogu („Cybernetyka”).</li>
    {{/each}}
  </ul>
  {{/if}}

  <h3>Rany, okaleczenia i DT</h3>
  {{#if bodyMap}}
  <div class="body-map">
    <svg class="pip-body" viewBox="{{bodyMap.viewBox}}" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Stan części ciała">
      {{#each bodyMap.callouts}}<line class="lead {{cls}}" x1="{{lx1}}" y1="{{ly1}}" x2="{{lx2}}" y2="{{ly2}}"/>{{/each}}
      <g transform="translate({{bodyMap.dx}},{{bodyMap.dy}})">
        {{#each bodyMap.parts}}<path class="part {{cls}}{{#if far}} far{{/if}}" d="{{d}}" style="--fill: {{fill}}" data-action="woundStep" data-loc="{{key}}"><title>{{title}}</title></path>{{/each}}
        {{#each bodyMap.decor}}<path class="decor" d="{{this}}"/>{{/each}}
        {{#if bodyMap.eye}}<circle class="decor eye" cx="{{bodyMap.eye.cx}}" cy="{{bodyMap.eye.cy}}" r="6"/><circle class="decor eye-hl" cx="{{bodyMap.eye.cx}}" cy="{{bodyMap.eye.cy}}" r="2" transform="translate(-2,-2)"/>{{/if}}
      </g>
      {{#each bodyMap.callouts}}
      <g class="callout {{cls}}" data-action="woundStep" data-loc="{{key}}">
        <rect class="box" x="{{x}}" y="{{y}}" width="{{w}}" height="{{h}}" rx="3"/>
        <text x="{{tx}}" y="{{y}}"><tspan class="nm" x="{{tx}}" dy="15">{{name}}</tspan><tspan x="{{tx}}" dy="15">{{line1}}</tspan><tspan x="{{tx}}" dy="14">{{line2}}</tspan><tspan class="dim" x="{{tx}}" dy="14">{{line3}}</tspan></text>
        <rect class="bar-bg" x="{{tx}}" y="{{y}}" width="128" height="3" transform="translate(0,{{h}}) translate(0,-7)"/>
        <rect class="bar" x="{{tx}}" y="{{y}}" width="{{bar}}" height="3" transform="translate(0,{{h}}) translate(0,-7)"/>
      </g>
      {{/each}}
    </svg>
    <p class="hint">Klik na część ciała albo jej opis: +1 rana · prawy przycisk (albo Shift+klik): −1. Pogrubiony, przerywany obrys — część osłania pancerz; ⚙ — proteza. Najedź, by zobaczyć progi i źródła DT.</p>
  </div>
  <details class="locs-details"><summary>Tabela lokacji (edycja ran, DT, okaleczeń)</summary>
  {{/if}}
  <div class="scroll-x">
  <table class="foe-table locs">
    <thead><tr><th class="l">Lokacja</th><th title="Rany / Endurance">Rany</th><th>Stan</th><th title="Najwyższe DT założonego pancerza (warstwy się nie sumują)">Pancerz</th><th title="Naturalne DT, perki, cechy — dodaje się do pancerza">Inne DT</th><th title="DT razem">DT</th><th title="Okaleczenie ręczne (np. z wady albo decyzji MG)">Okal.</th></tr></thead>
    <tbody>
    {{#each locations}}
      <tr class="st-{{status}}">
        <td class="l">{{label}}{{#if mfdNote}} <small class="sub">{{mfdNote}}</small>{{/if}}</td>
        <td class="nw"><input type="number" name="system.locations.{{key}}.wounds" value="{{wounds}}" min="0"><small class="sub">/{{limit}}</small></td>
        <td class="status">{{statusLabel}}</td>
        <td {{#if armorName}}title="{{armorName}}"{{/if}}>{{#if armorName}}{{armorDt}}{{else}}—{{/if}}</td>
        <td class="nw"><input type="number" name="system.locations.{{key}}.dt" value="{{dt}}">{{#if dtFxLabel}}<span class="fxb" title="Z cech">{{dtFxLabel}}</span>{{/if}}</td>
        <td class="tn">{{dtTotal}}</td>
        <td><input type="checkbox" name="system.locations.{{key}}.crippled" {{checked crippled}}></td>
      </tr>
    {{/each}}
    </tbody>
  </table>
  </div>
  {{#if bodyMap}}</details>{{/if}}
  {{#if stateFx.length}}
  <div class="state-fx"><span>Kary z ran i obciążenia (liczą się same w rzutach)</span><ul>{{#each stateFx}}<li>{{this}}</li>{{/each}}</ul></div>
  {{/if}}
  <p class="hint">Okaleczenie od {{crippleAt}} ran, {{endT}} ran w głowie albo tułowiu to śmierć, w kończynie — jej utrata. DT pancerza bierze się z założonych pancerzy (zakładka Ekwipunek); „Inne DT” (naturalne, perki) się do niego dodaje.</p>
</section>
