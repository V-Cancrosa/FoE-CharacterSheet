<section class="tab {{tab.cssClass}}" data-group="primary" data-tab="magic">
  {{#if shadow.show}}
  <h3>{{t "Shadow magic"}}</h3>
  <div class="status-bar">
    {{#if shadow.flash}}<span class="cs" title="{{t "AGI + PER + 2; recovers 1 per hour of game time"}}">{{t "Shadow strain"}} <b>{{shadow.value}}/{{shadow.max}}</b>{{#if shadow.spent}} · {{t "+1 in {n} min" n=shadow.nextMin}}{{/if}}</span>{{/if}}
    <span class="cs">Flight MFD 1 <b>{{shadow.tn}}</b></span>
    {{#if shadow.flash}}<span class="cs" title="Teleportation I: 10×INT ft">Teleport <b>{{shadow.teleport}} ft</b></span>{{/if}}
    {{#if shadow.bat}}<span class="cs" title="{{t "Echolocation (p. 35)"}}">{{t "No darkness penalties · “sees” 60 ft"}}</span>{{/if}}
  </div>
  <div class="veh-actions shadow-actions">
    {{#each shadow.modes}}<a data-action="castShadow" data-mode="{{key}}" title="{{note}} (Flight MFD {{mfd}} ≤ {{tn}}{{#if cost}}, {{t "cost {c}" c=cost}}{{/if}})"><i class="fa-solid fa-moon"></i> {{label}}</a>{{/each}}
    {{#if shadow.bat}}{{#unless shadow.hasScreech}}<a data-action="addScreech" title="{{t "Add the racial attack to weapons (3d12, ignores armor)"}}"><i class="fa-solid fa-volume-high"></i> {{t "Add Sonic Screech"}}</a>{{/unless}}{{/if}}
  </div>
  <p class="hint">{{#if shadow.flash}}{{t "Shadowflash (p. 35): dodge — Flight MFD ½, a success means a successful dodge; teleport — MFD ¾, only you and held items, momentum is lost. Costs 2 from the shadow pool. Magic suppression doesn't work on shadow magic."}}{{else}}{{#if shadow.bat}}{{t "A bat pony can have the Shadowflash trait (1 point at character creation, creator → Hindrances and traits; not with Young)."}}{{/if}}{{/if}}
    {{#if shadow.form}} {{t "Shadow Form (Black Book): +4 MFD steps to sneaking in shadows and jumping between shadows up to 40 ft."}}{{/if}}</p>
  {{/if}}

  {{#if changeling}}
  <h3>{{t "Changeling"}} <small>{{t "house rules"}}</small></h3>
  <div class="status-bar">
    <span class="cs {{#if changeling.starving}}alert{{/if}}" title="{{t "CHA + END; 1 per day for upkeep, 1 per transformation"}}">{{t "Love"}} <b>{{changeling.value}}/{{changeling.max}}</b></span>
    <a class="cs act" data-action="setLove" title="{{t "Set manually"}}"><i class="fa-solid fa-pen"></i></a>
    {{#if changeling.disguise}}<span class="cs" title="{{t "Only the owner and the GM see the real name"}}">{{t "Disguised as:"}} <b>{{changeling.disguise.name}}</b> ({{changeling.disguise.race}})</span>{{/if}}
    {{#if changeling.starving}}<span class="cs alert">{{t "HUNGER — −1 step END and CHA"}}</span>{{/if}}
  </div>
  <div class="veh-actions">
    <a data-action="shapeshift" title="{{t "Take the appearance and voice of a pony you can see (1 love)"}}"><i class="fa-solid fa-masks-theater"></i> {{t "Transform"}}</a>
    {{#if changeling.disguise}}<a data-action="endDisguise" title="{{t "Return to your own form"}}"><i class="fa-solid fa-rotate-left"></i> {{t "Own form"}}</a>
    <a data-action="detectDisguise" title="{{t "Select the observer's token: PER roll, MFD by familiarity with the original"}}"><i class="fa-solid fa-eye"></i> {{t "Detect disguise"}}</a>{{/if}}
    <a data-action="feedLove" title="{{t "Speechcraft: success +1d4 love"}}"><i class="fa-solid fa-heart"></i> {{t "Feed"}}</a>
  </div>
  <p class="hint">{{t "The v1.22 rulebook has no changeling rules (announced for book II) — these are house rules described in the README. They change their voice naturally (like Voice Alteration); they can cast Perfect Illusion despite level 4."}}</p>
  {{/if}}
  {{#if flight.flier}}
  <div class="status-bar">
    <span class="cs">Flight: {{t "rank"}} <b>{{flight.rank}}</b> · MFD 1 <b>{{flight.tn}}</b></span>
    <span class="cs" title="{{t "5×AGI ft per action"}}">{{t "fx|Flight"}} <b>{{#if flight.canFly}}{{flight.speed}} ft{{else}}{{flight.note}}{{/if}}</b></span>
    <label class="cs alt" title="{{t "Current altitude above the ground"}}">{{t "Altitude"}} <input type="number" name="system.altitude" value="{{flight.altitude}}" min="0" step="5"> ft</label>
    <span class="cs {{#if flight.over}}alert{{/if}}" title="{{t "Level 1+ maneuvers (Flight rank / 10); level 0 is free"}}">{{t "Maneuvers"}} <b>{{flight.known}}/{{flight.total}}</b></span>
    {{#if flight.load}}<span class="cs warn" title="{{t "Every pound over 100 is −1 to Flight rolls"}}">{{t "Load −{n}" n=flight.load}}</span>{{/if}}
    <span class="cs" title="{{flight.weather.summary}}"><i class="fa-solid fa-cloud-sun-rain"></i> {{flight.weather.label}}</span>
    <a class="cs act" data-action="rollFall" title="{{t "1d20 per 10 ft (controlled 1d10), ignores armor DT"}}"><i class="fa-solid fa-person-falling"></i> {{t "Fall"}}</a>
  </div>
  <h3>{{t "Flight and maneuvers"}} {{rule "races/flight"}}
    <a data-action="openCatalog" data-tab="maneuvers" title="{{t "Flight maneuvers from the rulebook (weather ones too)"}}"><i class="fa-solid fa-feather"></i> {{t "Catalog"}}</a>
  </h3>
  {{#each flight.levels}}
    <h4 class="gear-cat">{{t "Level {n}" n=level}} <small class="{{#if over}}warn{{/if}}">{{#if level}}{{t "rank {r}" r=rankReq}}{{#if limit}} · {{count}} / {{limit}}{{/if}}{{else}}{{t "no limit"}}{{/if}}{{#if locked}} · <span class="warn">{{t "rank too low"}}</span>{{/if}}</small></h4>
    <div class="scroll-x">
    <table class="foe-table items spells maneuvers">
      <tbody>
      {{#each list}}
        <tr data-item-id="{{id}}" class="{{#unless learned}}unlearned{{/unless}}">
          <td><img class="icon" src="{{img}}" alt=""></td>
          <td class="l"><a class="rollable" data-action="performManeuver" title="{{#if learned}}{{t "Perform the maneuver (Flight roll)"}}{{else}}{{t "Practice the maneuver: Flight roll with a 3-step penalty"}}{{/if}}">{{name}}</a>{{#if tags.length}}<div class="wtags">{{#each tags}}<span>{{this}}</span>{{/each}}</div>{{/if}}</td>
          <td title="{{t "MFD to perform"}}">{{mfd}}</td>
          <td title="{{t "Actions"}}">{{actions}}</td>
          <td title="{{t "Mastery (attempt limit = character level)"}}">{{#if learned}}<span class="ok">{{t "mastered"}}</span>{{else}}<span class="warn">{{t "learning {a}/{b}" a=attempts b=attemptsMax}}</span>{{/if}}</td>
          <td class="ctl"><a data-action="editItem" title="{{t "Edit"}}"><i class="fa-solid fa-pen"></i></a> <a data-action="deleteItem" title="{{t "Delete"}}"><i class="fa-solid fa-trash"></i></a></td>
        </tr>
      {{/each}}
      </tbody>
    </table>
    </div>
  {{/each}}
  {{#if flight.empty}}<p class="empty">{{t "No maneuvers."}} <a class="rollable" data-action="startManeuvers"><i class="fa-solid fa-feather"></i> {{t "Add level 0 maneuvers"}}</a> {{t "or pick them from the catalog."}}</p>{{/if}}
  <p class="hint">{{t "Click a maneuver to perform it (Flight roll at its MFD; weather and load over 100 lb are counted automatically). A new maneuver must first be mastered: a roll with a 3-step penalty, as many attempts as you have levels. Aerial dodges replace the normal dodge. Weather maneuvers (Cloudbuck, Cloud Cover, Fog Bank…) change the weather — the GM sets it in the combat tab."}}</p>
  {{/if}}

  {{#if magic.caster}}
  <div class="status-bar">
    <span class="cs" title="END + INT + {{#if magic.alicorn}}5{{else}}2{{/if}} + {{t "features; recovers 1 per hour"}}">Strain <b>{{magic.strain}}/{{magic.strainMax}}</b></span>
    <a class="cs act" data-action="strainRest" title="{{t "An hour of rest: +1 strain (Shift: to full)"}}"><i class="fa-solid fa-bed"></i> +1 strain</a>
    <span class="cs">Magic: {{t "rank"}} <b>{{magic.rank}}</b> · MFD 1 <b>{{magic.tn}}</b></span>
    {{#if magic.burnout}}<span class="cs alert">{{t "BURNOUT — no spells for 1d4 weeks"}}</span> <a class="cs act" data-action="clearBurnout" title="{{t "Burnout is over"}}"><i class="fa-solid fa-xmark"></i> {{t "end burnout"}}</a>{{/if}}
  </div>

  {{#if magic.maintained.length}}
  <h3>{{t "Maintained spells"}} {{rule "races/magic"}}</h3>
  <ul class="item-list conditions">
    {{#each magic.maintained}}
    <li><span class="nm">{{name}}</span><span class="cdesc">{{perRound}} {{t "strain at the start of the round"}}{{#if layers}} (overglow {{layers}}){{/if}}; {{t "new spells cost ×2, −1 step to accuracy, INT and AGI"}}</span>
      <span class="ctl"><a data-action="endMaintain" data-id="{{id}}" title="{{t "Stop maintaining"}}"><i class="fa-solid fa-xmark"></i></a></span></li>
    {{/each}}
  </ul>
  {{/if}}

  <h3>{{t "Spells"}} {{rule "races/magic"}}
    <a data-action="openCatalog" data-tab="spells" title="{{t "Unicorn and alicorn spells from the rulebook"}}"><i class="fa-solid fa-book"></i> {{t "Catalog"}}</a>
  </h3>
  {{#each magic.levels}}
    <h4 class="gear-cat">{{t "Level {n}" n=level}} <small class="{{#if over}}warn{{/if}}">{{count}}{{#if limit}} / {{limit}}{{/if}}</small></h4>
    <div class="scroll-x">
    <table class="foe-table items spells">
      <tbody>
      {{#each spells}}
        <tr data-item-id="{{id}}" class="{{#if held}}worn{{/if}}">
          <td><img class="icon" src="{{img}}" alt=""></td>
          <td class="l"><a class="rollable" data-action="castSpell" title="{{t "Cast the spell (Magic, overglow, SATS)"}}">{{name}}</a>{{#if tags.length}}<div class="wtags">{{#each tags}}<span>{{this}}</span>{{/each}}</div>{{/if}}</td>
          <td title="{{t "Strain cost"}}">{{costLabel}}</td>
          <td title="{{t "SATS cost"}}">{{#if satsCost}}{{satsCost}} AP{{else}}—{{/if}}</td>
          <td title="{{t "Learning percentage (+1% per cast)"}}">{{learn}}%</td>
          <td class="ctl"><a data-action="editItem" title="{{t "Edit"}}"><i class="fa-solid fa-pen"></i></a> <a data-action="deleteItem" title="{{t "Delete"}}"><i class="fa-solid fa-trash"></i></a></td>
        </tr>
      {{else}}<tr><td class="empty" colspan="6">{{t "No spells of this level."}}</td></tr>
      {{/each}}
      </tbody>
    </table>
    </div>
  {{/each}}
  <p class="hint">{{t "Click a spell to cast it: you choose overglow (each layer doubles the effect and cost, max. 3) and optionally SATS. When you run out of strain, the roll is harder by every missing point, and a failure ends in burnout. Damage spells have an aiming button (Magic, range increment 20 ft) or a damage button on their card. Limits: level 2 — INT, level 3 — INT/3, level 4 — one (alicorns have no limit up to level 3)."}}</p>
  {{else}}{{#unless zebra.mage}}{{#unless flight.flier}}
  <p class="empty">{{t "This character knows no magic (has no Magic skill)."}}</p>
  {{/unless}}{{/unless}}{{/if}}

  {{#if zebra.mage}}
  <div class="status-bar">
    <span class="cs">{{t "Zebra magic:"}} {{t "rank"}} <b>{{zebra.rank}}</b> · MFD 1 <b>{{zebra.tn}}</b></span>
    <span class="cs" title="{{t "Every preparation uses this many ingredients (−1 per 25 Magic ranks, min. 1)"}}">{{t "Per product:"}} <b>{{zebra.perPrep}}</b> {{t "ingr."}}</span>
    {{#each zebra.stock}}<span class="cs" title="{{t "Ingredients of this rarity"}}">{{label}} <b>{{n}}</b></span>{{/each}}
    <a class="cs act" data-action="searchIngredients" title="{{t "Survival or Magic, MFD depends on the terrain"}}"><i class="fa-solid fa-magnifying-glass"></i> {{t "Search for ingredients"}}</a>
  </div>
  <h3>{{t "Zebra recipes"}} {{rule "races/zebra"}}
    <a data-action="openCatalog" data-tab="recipes" title="{{t "Recipes from the rulebook"}}"><i class="fa-solid fa-book"></i> {{t "Catalog"}}</a>
  </h3>
  <div class="scroll-x">
  <table class="foe-table items spells recipes">
    <thead><tr><th></th><th class="l">{{t "Recipe"}}</th><th>{{t "short|Lvl"}}</th><th>{{t "Ingredients"}}</th><th class="l">{{t "Prepare / cast"}}</th><th></th></tr></thead>
    <tbody>
    {{#each zebra.recipes}}
      <tr data-item-id="{{id}}">
        <td><img class="icon" src="{{img}}" alt=""></td>
        <td class="l nm">{{name}}<div class="wtags">{{#if school}}<span>{{school}}</span>{{/if}}{{#if special}}<span title="{{t "Special ingredient"}}">+ {{special}}</span>{{/if}}{{#if damage}}<span>{{t "dmg {d}" d=damage}}</span>{{/if}}</div></td>
        <td>{{level}}</td>
        <td>{{rarityLabel}}</td>
        <td class="l modes">{{#each modes}}{{#if ritual}}<a class="mode-btn ritual" data-action="castRitual" title="{{t "Combat ritual: ingredients + Magic roll, 1 action / 40 AP"}}"><i class="fa-solid fa-hand-sparkles"></i> {{t "Ritual"}}</a>{{else}}<a class="mode-btn" data-action="prepareRecipe" data-mode="{{key}}" title="{{t "{tip}: uses ingredients and adds the product to the Inventory" tip=tip}}"><i class="fa-solid fa-mortar-pestle"></i> {{label}}</a>{{/if}}{{/each}}</td>
        <td class="ctl"><a data-action="editItem" title="{{t "Edit"}}"><i class="fa-solid fa-pen"></i></a> <a data-action="deleteItem" title="{{t "Delete"}}"><i class="fa-solid fa-trash"></i></a></td>
      </tr>
    {{else}}<tr><td class="empty" colspan="6">{{#if zebra.start}}{{t "No recipes — pick {n} from the catalog (at start: level 0–1, Magic rank / 10, max. 5)." n=zebra.start}}{{else}}{{t "No recipes — pick them from the catalog (at start: level 0–1, Magic rank / 10, max. 5)."}}{{/if}}</td></tr>
    {{/each}}
    </tbody>
  </table>
  </div>
  <p class="hint">{{t "Zebras have no strain — every preparation uses 1d4+1 ingredients of the recipe's rarity. Missing ones are replaced by rarer ingredients (1:1) or four one step more common. Potions and talismans go to the Inventory (“Use” button: drinking 15 AP, applying 25 AP, throwing 35 AP — range increment 10 ft). Rituals are cast right away in combat (1 action / 40 AP)."}}</p>
  {{/if}}
</section>
