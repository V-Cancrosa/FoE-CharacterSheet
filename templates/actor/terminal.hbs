<section class="tab active terminal-body">
{{#if config}}
  <header class="foe-header">
    <div class="pip-bar"><span>{{t "PIPBUCK 3000 · TERMINAL REGISTRY"}}</span><span>{{t "GM CONFIGURATION"}}</span></div>
    <div class="foe-id">
      <img class="portrait" src="{{actor.img}}" data-action="portrait" alt="{{actor.name}}">
      <div class="identity">
        <input class="name" type="text" name="name" value="{{actor.name}}" placeholder="{{t "Terminal name"}}">
        <div class="row veh-row">
          <label>{{t "Type"}} <select name="system.kind">{{#each kinds}}<option value="{{value}}" {{#if sel}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
          {{#if isMinistry}}<label title="{{t "Which of the six ministries the terminal belongs to: header, logo and screen color"}}">{{t "Ministry"}} <select name="system.ministry">{{#each ministries}}<option value="{{value}}" {{#if sel}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>{{/if}}
          <label title="{{t "Hacking difficulty (MFD of the Science roll; in the minigame — word length and fewer hints)"}}">{{t "Security"}} <select name="system.security">{{#each security}}<option value="{{value}}" {{#if sel}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
        </div>
        <div class="row veh-row">
          <label title="{{t "Minimum Science rank to attempt hacking at all (p. 61)"}}">{{t "Required Science"}} <input type="number" name="system.scienceReq" value="{{t.scienceReq}}" min="0" step="5"></label>
          <label class="cbx"><input type="checkbox" name="system.powered" {{#if t.powered}}checked{{/if}}> {{t "powered"}}</label>
        </div>
      </div>
    </div>
  </header>

  <div class="veh-actions">
    <a data-action="toggleView" title="{{t "See the screen as the players see it"}}"><i class="fa-solid fa-display"></i> {{t "Screen preview"}}</a>
    <a data-action="resetTerminal" title="{{t "Log out, remove lockouts, abort the minigame, clear the log and turn the terminal off"}}"><i class="fa-solid fa-rotate-left"></i> {{t "Reset state"}}</a>
  </div>
  <p class="hint">{{t "Players open the terminal by clicking its token (the “limited” permission is set automatically on creation). They only see the computer screen. State changes are made by the GM's browser — you have to be logged in."}}{{#if reach}} {{t "A player acts only while their token stands next to the terminal's token (with a cable, a remote-control implant or a spark wire — from further away)."}}{{/if}}{{#if minigame}} {{t "Hacking:"}} <b>{{t "minigame"}}</b> {{t "(world settings)."}}{{else}} {{t "Hacking:"}} <b>{{t "Science roll"}}</b> {{t "(you can turn the minigame on in the world settings)."}}{{/if}}</p>

  <div class="term-config">
    <fieldset>
      <legend>{{t "Screen and passwords"}}</legend>
      <label class="atk-row">{{t "Header"}} <input type="text" name="system.brand" value="{{t.brand}}" placeholder="{{t "default for the type"}}"></label>
      <label class="atk-row">{{t "Password"}} <input type="text" name="system.password" value="{{t.password}}" placeholder="{{t "none — hacking only"}}"></label>
      <label class="atk-row">{{t "Administrator password"}} <input type="text" name="system.adminPassword" value="{{t.adminPassword}}" placeholder="{{t "none"}}"></label>
      <label class="atk-row stack">{{t "Welcome text (shown before logging in)"}}<textarea name="system.welcome" rows="2">{{t.welcome}}</textarea></label>
    </fieldset>

    <fieldset>
      <legend>{{t "Entries"}} ({{entries.length}}) <a data-action="addEntry" title="{{t "Add entry"}}"><i class="fa-solid fa-plus"></i></a></legend>
      {{#each entries}}
      <div class="term-row">
        <div class="row">
          <input type="text" name="te.{{i}}.title" value="{{title}}" placeholder="{{t "Title"}}">
          <select name="te.{{i}}.access" title="{{t "Who sees the entry"}}">{{#each access}}<option value="{{value}}" {{#if sel}}selected{{/if}}>{{label}}</option>{{/each}}</select>
          <a data-action="delEntry" data-i="{{i}}" title="{{t "Delete entry"}}"><i class="fa-solid fa-trash"></i></a>
        </div>
        <textarea name="te.{{i}}.body" rows="4" placeholder="{{t "Content (plain text, line breaks are kept)"}}">{{body}}</textarea>
      </div>
      {{else}}<p class="hint">{{t "No entries. Add logs, notes, e-mails — each with an access level."}}</p>{{/each}}
    </fieldset>

    <fieldset>
      <legend>{{t "Commands"}} ({{commands.length}}) <a data-action="addCommand" title="{{t "Add command"}}"><i class="fa-solid fa-plus"></i></a></legend>
      {{#each commands}}
      <div class="term-row">
        <div class="row">
          <input type="text" name="tc.{{i}}.label" value="{{label}}" placeholder="{{t "Text on the screen"}}">
          <select name="tc.{{i}}.kind">{{#each kinds}}<option value="{{value}}" {{#if sel}}selected{{/if}}>{{label}}</option>{{/each}}</select>
          <select name="tc.{{i}}.action">{{#each actions}}<option value="{{value}}" {{#if sel}}selected{{/if}}>{{label}}</option>{{/each}}</select>
          <select name="tc.{{i}}.access" title="{{t "Who can use it"}}">{{#each access}}<option value="{{value}}" {{#if sel}}selected{{/if}}>{{label}}</option>{{/each}}</select>
          <a data-action="delCommand" data-i="{{i}}" title="{{t "Delete command"}}"><i class="fa-solid fa-trash"></i></a>
        </div>
        {{#if isMessage}}
        <input type="text" name="tc.{{i}}.text" value="{{text}}" placeholder="{{t "Chat message text (e.g. ALARM — sector B)"}}">
        {{else}}
        <div class="row hint">
          <span>{{t "Linked:"}} <b>{{#if targetNames}}{{targetNames}}{{else}}{{t "nothing"}}{{/if}}</b></span>
          <a data-action="pickTargets" data-i="{{i}}" title="{{t "Add what is selected on the scene"}} ({{#if (eq kind "door")}}{{t "doors — walls layer"}}{{else}}{{t "tokens"}}{{/if}})"><i class="fa-solid fa-link"></i> {{t "add selected"}}</a>
          <a data-action="clearTargets" data-i="{{i}}" title="{{t "Unlink everything"}}"><i class="fa-solid fa-link-slash"></i></a>
        </div>
        {{/if}}
      </div>
      {{else}}<p class="hint">{{t "No commands. E.g. “Open the door” (link doors from the scene), “Turn off the turrets” (link tokens), “Alarm” (a message)."}}</p>{{/each}}
    </fieldset>

    <fieldset>
      <legend>{{t "Trap (Rigged Terminal, p. 597)"}}</legend>
      <div class="row">
        <label class="cbx"><input type="checkbox" name="system.trap.armed" {{#if t.trap.armed}}checked{{/if}}> {{t "armed"}}</label>
        <label>{{t "Charge"}} <select name="system.trap.explosive">{{#each explosives}}<option value="{{value}}" {{#if sel}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
        <label title="{{t "Difficulty of inspecting and disarming (Explosives)"}}">{{t "Detection"}} <select name="system.trap.noticeMfd">{{#each mfds}}<option value="{{value}}" {{#if sel}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
        <label title="{{t "Which of the 4 screws in the corners of the screen hides the inspection (and, once the charge is found, the disarming)"}}">{{t "Screw"}} <select name="system.trap.screw">{{#each screws}}<option value="{{value}}" {{#if sel}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
      </div>
      <p class="hint">{{t "Turning on an armed terminal: an explosion hits the character who turned it on (a card with “Apply damage”). Inspecting and disarming — Explosives; a critical failure sets off the charge too."}}</p>
      <p class="hint"><b>{{t "Inspection has no button on the screen."}}</b> {{t "When a player says they check the terminal for a charge (before turning it on), tell them to click"}} <b>{{screwClick}}</b> {{t "— it opens the Explosives roll. A detected charge is then shown openly, with a “Disarm” button."}} {{t "The same screw disarms it too."}}</p>
    </fieldset>

    <fieldset>
      <legend>{{t "State"}}</legend>
      <div class="row">
        <label>{{t "Access"}} <select name="system.state.access">{{#each accessStates}}<option value="{{value}}" {{#if sel}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
        <label title="{{t "0 — works; 1 — hacking only with Computer Whiz (the password works); 2 — locked for good"}}">{{t "Lockouts"}} <input type="number" name="system.state.lockouts" value="{{t.state.lockouts}}" min="0" max="2"></label>
        <label class="cbx"><input type="checkbox" name="system.state.booted" {{#if t.state.booted}}checked{{/if}}> {{t "booted"}}</label>
        <label class="cbx"><input type="checkbox" name="system.state.trapFound" {{#if t.state.trapFound}}checked{{/if}}> {{t "trap detected"}}</label>
      </div>
      {{#if t.state.log.length}}<pre class="term-log small">{{#each t.state.log}}{{this}}
{{/each}}</pre>{{/if}}
    </fieldset>

    <fieldset>
      <legend>{{t "GM notes"}}</legend>
      <textarea name="system.notes" rows="3">{{t.notes}}</textarea>
    </fieldset>
  </div>
{{else}}
  <div class="term-screen kind-{{screen.kind}}{{#if screen.ministry}} min-{{screen.ministry}}{{/if}}">
    <div class="term-head">
      <span class="screw tl" aria-hidden="true"{{#if screen.screws.tl}} data-action="{{screen.screws.tl}}"{{/if}}>◦</span><span class="screw tr" aria-hidden="true"{{#if screen.screws.tr}} data-action="{{screen.screws.tr}}"{{/if}}>◦</span>
      <div>{{screen.brand}}</div>
      <div class="term-sub">{{screen.name}}{{#if screen.admin}} · ADMIN{{/if}}</div>
    </div>
    <div class="term-body">
      {{#if (eq screen.mode "far")}}
        <div class="term-big">{{t "TOO FAR"}}</div>
        <p>&gt; {{screen.farWhy}}.</p>
        <p>&gt; {{t "Stand with your token on a square next to the terminal to use it."}}</p>
      {{else if (eq screen.mode "off")}}
        <div class="term-big">{{t "NO POWER"}}</div>
      {{else if (eq screen.mode "locked")}}
        <div class="term-big alert">{{t "TERMINAL LOCKED"}}</div>
        <p>{{t "CONTACT THE ADMINISTRATOR."}}</p>
      {{else if (eq screen.mode "denied")}}
        <div class="term-big alert">{{t "ACCESS DENIED"}}</div>
        {{#each screen.why}}<p>&gt; {{this}}</p>{{/each}}
      {{else if (eq screen.mode "boot")}}
        <p>&gt; {{t "the screen is dark. The power switch is under the casing."}}</p>
        {{#if screen.trapFound}}<p class="alert">&gt; {{t "UNDER THE CASING: AN EXPLOSIVE CHARGE WIRED TO THE POWER SUPPLY"}}</p>{{/if}}
        <div class="term-menu">
          <button type="button" data-action="boot">[ {{t "Turn the terminal on"}} ]</button>
          {{#if screen.trapFound}}<button type="button" data-action="disarm">[ {{t "Disarm the charge (Explosives)"}} ]</button>{{/if}}
        </div>
      {{else if (eq screen.mode "game")}}
        <p>&gt; {{t "PASSWORD REQUIRED · ATTEMPTS:"}} {{#each screen.game.tries}}<span class="term-try">▮</span>{{/each}}</p>
        <div class="term-dump">
          {{#each screen.game.cols}}
          <div class="col">
            {{#each this}}<div class="dl"><span class="addr">{{addr}}</span> {{#each parts}}{{#if word}}<a class="w" data-action="guess" data-word="{{word}}">{{this.t}}</a>{{else if dud}}<span class="dud">{{this.t}}</span>{{else}}<span>{{this.t}}</span>{{/if}}{{/each}}</div>{{/each}}
          </div>
          {{/each}}
        </div>
        <div class="term-menu">
          {{#if screen.game.hints}}<button type="button" data-action="hint">[ {{t "Remove a dud — Science: {n}" n=screen.game.hints}} ]</button>{{/if}}
          {{#unless screen.game.analyzed}}<button type="button" data-action="analyze">[ {{t "Dump analysis — Science roll (once)"}} ]</button>{{/unless}}
          <button type="button" data-action="abortGame">[ {{t "Abort"}} ]</button>
        </div>
      {{else if (eq screen.mode "entry")}}
        <div class="term-title">{{screen.entry.title}}</div>
        <div class="term-text">{{#each screen.entry.lines}}<div>{{this}}&nbsp;</div>{{/each}}</div>
        <div class="term-menu">
          <button type="button" data-action="back">[ &lt; {{t "Back"}} ]</button>
          <button type="button" data-action="download" data-id="{{screen.entry.id}}">[ {{t "Copy to a holotape"}} ]</button>
        </div>
      {{else}}
        {{#if screen.welcome}}<p class="term-welcome">{{screen.welcome}}</p>{{/if}}
        {{#if (eq screen.mode "login")}}
          <p>&gt; {{t "WELCOME. ENTER THE PASSWORD"}}{{#if screen.lockedOnce}} {{t "(HACKING LOCKED)"}}{{/if}}:</p>
          <div class="term-login">&gt; <input type="password" name="password" autocomplete="off"> <button type="button" data-action="login">[ {{t "Log in"}} ]</button></div>
          <div class="term-menu">
            <button type="button" data-action="hack" {{#unless screen.canHack}}title="{{#each screen.why}}{{this}}; {{/each}}"{{/unless}}>[ {{#if screen.minigame}}{{t "Memory dump (hacking)"}}{{else}}{{t "Hack (Science)"}}{{/if}} ]</button>
          </div>
          {{#if screen.entries.length}}<div class="term-title">{{t "PUBLIC FILES"}}</div>{{/if}}
        {{else}}
          <div class="term-title">{{#if screen.admin}}{{t "ADMINISTRATOR MENU"}}{{else}}MENU{{/if}}</div>
        {{/if}}
        <div class="term-menu">
          {{#each screen.entries}}<button type="button" data-action="openEntry" data-id="{{id}}">[ {{title}} ]</button>{{/each}}
          {{#if (ne screen.mode "login")}}
            {{#each screen.commands}}<button type="button" class="cmd" data-action="command" data-id="{{id}}">[ &gt; {{label}} ]</button>{{/each}}
            <button type="button" data-action="logout">[ {{t "Log out"}} ]</button>
          {{/if}}
        </div>
      {{/if}}
      {{#if screen.log.length}}<pre class="term-log">{{#each screen.log}}{{this}}
{{/each}}</pre>{{/if}}
    </div>
    <div class="term-case" aria-hidden="true"><span class="screw"{{#if screen.screws.bl}} data-action="{{screen.screws.bl}}"{{/if}}>◦</span><span class="grill">▤▤▤▤▤▤▤▤▤▤▤▤▤▤</span><span class="screw"{{#if screen.screws.br}} data-action="{{screen.screws.br}}"{{/if}}>◦</span></div>
    <div class="term-foot">
      <span>{{t "User: {who}" who=screen.who}}{{#if screen.via}} · {{t "connection: {via}" via=screen.via}}{{/if}}</span>
      {{#if isGM}}<a data-action="toggleView"><i class="fa-solid fa-gear"></i> {{t "configuration"}}</a>{{/if}}
    </div>
  </div>
{{/if}}
</section>
