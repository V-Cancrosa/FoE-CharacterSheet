<section class="tab active casino-body">
{{#if config}}
  <header class="foe-header">
    <div class="pip-bar"><span>{{t "PIPBUCK 3000 · CASINO"}}</span><span>{{t "GM CONFIGURATION"}}</span></div>
    <div class="foe-id">
      <img class="portrait" src="{{actor.img}}" data-edit="img" data-action="editImage" alt="{{actor.name}}">
      <div class="identity">
        <input class="name" type="text" name="name" value="{{actor.name}}" placeholder="{{t "Table name"}}">
        <div class="row veh-row">
          <label title="{{#if locked}}{{t "You can change the game once nobody sits at the table"}}{{else}}{{t "The game at this table"}}{{/if}}">{{t "Game"}} <select name="system.game" {{#if locked}}disabled{{/if}}>{{#each games}}<option value="{{value}}" {{#if sel}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
          <label class="cbx" title="{{t "Closed table: nobody sits down, bets or starts a hand"}}"><input type="checkbox" name="system.open" {{#if sys.open}}checked{{/if}}> {{t "table open"}}</label>
        </div>
        <div class="row veh-row">
          <label class="wide">{{t "Dealer"}} <input type="text" name="system.dealer" value="{{sys.dealer}}" placeholder="{{t "Dealer"}}"></label>
        </div>
      </div>
    </div>
  </header>

  <div class="veh-actions">
    <a data-action="toggleView" title="{{t "See the table as the players see it"}}"><i class="fa-solid fa-table-cells-large"></i> {{t "Table view"}}</a>
    {{#if playing}}<a data-action="voidHand" title="{{t "Void the current hand — the stakes go back to the players"}}"><i class="fa-solid fa-ban"></i> {{t "Void the hand"}}</a>{{/if}}
    {{#if seatCount}}<a data-action="closeTable" title="{{t "Void the hand, give everyone their caps from the table back and close the table"}}"><i class="fa-solid fa-door-closed"></i> {{t "Close the table ({n})" n=seatCount}}</a>{{/if}}
    <a data-action="clearLog" title="{{t "Clear the dealer's log"}}"><i class="fa-solid fa-eraser"></i> {{t "Clear the log"}}</a>
  </div>
  <p class="hint">{{t "Put the table token on the map (2×1 squares — you can change the size in the token settings)."}} {{#if reach}}{{t "Players open the table by clicking its token; they sit down while their character's token stands next to the table's token, and the caps come off the character sheet."}}{{else}}{{t "Players open the table by clicking its token; the caps come off the character sheet."}}{{/if}} {{t "Moves are made by the GM's browser — you have to be logged in."}} {{t "The deck, the shoe and the face-down cards live only in your browser's memory; if you reload the page during a hand, it is voided and the stakes go back to the players."}} {{t "You seat NPCs in the table view (select their tokens)."}}</p>

  <div class="cz-config">
    {{#if bj}}
    <fieldset>
      <legend>Blackjack</legend>
      <label class="atk-row">{{t "Minimum bet"}} <input type="number" name="system.minBet" value="{{sys.minBet}}" min="1" step="1"></label>
      <label class="atk-row">{{t "Maximum bet"}} <input type="number" name="system.maxBet" value="{{sys.maxBet}}" min="1" step="1"></label>
      <label class="atk-row" title="{{t "How many decks are in the shoe (it is reshuffled when less than ¼ remains)"}}">{{t "Decks in the shoe"}} <input type="number" name="system.decks" value="{{sys.decks}}" min="1" max="8" step="1"></label>
      <p class="hint">{{t "The dealer draws to 16 and stands on every 17. Blackjack pays 3:2, a win 1:1. Doubling on two cards (also after a split), one split of a pair (aces get one card each). The dealer peeks under the card with an ace or a ten. No insurance and no surrender."}}</p>
    </fieldset>
    {{/if}}
    {{#if he}}
    <fieldset>
      <legend>Texas Hold'em</legend>
      <label class="atk-row">{{t "Small blind"}} <input type="number" name="system.smallBlind" value="{{sys.smallBlind}}" min="1" step="1"></label>
      <label class="atk-row">{{t "Big blind"}} <input type="number" name="system.bigBlind" value="{{sys.bigBlind}}" min="1" step="1"></label>
      <label class="atk-row" title="{{t "How many caps a player puts on the table when sitting down (and the most they can have there)"}}">{{t "Buy-in from"}} <input type="number" name="system.buyInMin" value="{{sys.buyInMin}}" min="1" step="1"></label>
      <label class="atk-row">{{t "Buy-in up to"}} <input type="number" name="system.buyInMax" value="{{sys.buyInMax}}" min="1" step="1"></label>
      <label class="atk-row" title="{{t "Percent of every pot for the house once the flop has been dealt (0 — no rake)"}}">{{t "House rake (%)"}} <input type="number" name="system.rake" value="{{sys.rake}}" min="0" max="10" step="1"></label>
      <p class="hint">{{t "No limit: a raise must be at least the last raise (min. the big blind), all-in is always possible. Side pots for all-ins. Players see only their own cards; you see the NPCs' cards."}}</p>
    </fieldset>
    {{/if}}
    <fieldset>
      <legend>{{t "Casino bank"}}</legend>
      <label class="atk-row cbx-row"><span>{{t "Unlimited bank"}}</span> <input type="checkbox" name="system.bankUnlimited" {{#if sys.bankUnlimited}}checked{{/if}}></label>
      {{#unless sys.bankUnlimited}}<label class="atk-row" title="{{t "The house's caps at this table. When it can't cover the possible winnings, the dealer won't accept the bet — the bank can be broken"}}">{{t "Table bank"}} <input type="number" name="system.bank" value="{{sys.bank}}" step="1"></label>{{/unless}}
      <div class="atk-row"><span>{{t "House balance"}}</span> <span><b>{{sys.profit}}</b> {{tp sys.profit "cap" "caps"}} <a data-action="resetProfit" title="{{t "Reset the balance"}}"><i class="fa-solid fa-rotate-left"></i></a></span></div>
    </fieldset>
  </div>
{{else}}
  <div class="cz-table game-{{#if v.bj}}blackjack{{else}}holdem{{/if}}">
    <header class="cz-head">
      <div class="cz-title"><b>{{v.name}}</b><span>{{v.gameLabel}}</span></div>
      <div class="cz-stakes">{{v.stakes}}{{#if v.bank}} · <span class="cz-bank">{{v.bank}}</span>{{/if}}{{#if v.profit}} · <span class="cz-profit" title="{{t "House balance (only the GM sees it)"}}">{{t "balance {n}" n=v.profit}}</span>{{/if}}</div>
      {{#if isGM}}<a class="cz-cfg" data-action="toggleView" title="{{t "Table settings (only the GM sees them)"}}"><i class="fa-solid fa-gear"></i> {{t "settings"}}</a>{{/if}}
    </header>

    <div class="cz-felt">
      {{#unless v.open}}<div class="cz-closed">{{t "TABLE CLOSED"}}</div>{{/unless}}
      {{#if v.bj}}
      <div class="cz-dealer">
        <div class="cz-label">{{v.dealer.name}}</div>
        <div class="cz-cards">{{{v.dealer.cards}}}</div>
        {{#if v.dealer.total}}<div class="cz-total">{{v.dealer.total}}</div>{{/if}}
      </div>
      <div class="cz-motto">{{t "BLACKJACK PAYS 3 TO 2 · DEALER STANDS ON 17"}}</div>
      {{else}}
      <div class="cz-board">
        <div class="cz-label">{{v.dealerName}}</div>
        <div class="cz-cards">{{{v.board}}}</div>
        {{#if v.pot}}<div class="cz-pot">{{t "pot"}} <b>{{v.pot}}</b></div>{{/if}}
      </div>
      <div class="cz-motto">{{t "TEXAS HOLD'EM · NO LIMIT"}}</div>
      {{/if}}

      <div class="cz-seats">
        {{#each v.seats}}
        <div class="cz-seat{{#if turn}} turn{{/if}}{{#if me}} me{{/if}}{{#if folded}} folded{{/if}}{{#if leaving}} leaving{{/if}}{{#if won}} winner{{/if}}">
          <div class="cz-who">
            {{#if button}}<span class="cz-dbtn" title="{{t "Dealer button"}}">D</span>{{/if}}
            <b>{{name}}</b>{{#if npc}}<small class="cz-tag">NPC</small>{{/if}}{{#if leaving}}<small class="cz-tag">{{t "leaving"}}</small>{{/if}}
            {{#if ../isGM}}{{#unless leaving}}<a class="cz-kick" data-action="kick" data-seat="{{id}}" title="{{t "Remove from the table (the caps go back)"}}"><i class="fa-solid fa-xmark"></i></a>{{/unless}}{{/if}}
          </div>
          {{#if ../v.bj}}
            {{#each hands}}
            <div class="cz-hand{{#if active}} active{{/if}}{{#if result}} res-{{result}}{{/if}}">
              <div class="cz-cards">{{{cards}}}</div>
              <div class="cz-hinfo"><span class="cz-val" title="{{t "Hand value"}}">{{total}}</span><span class="cz-stake" title="{{t "Stake"}}{{#if doubled}} {{t "(doubled)"}}{{/if}}"><span class="cz-chip"></span>{{stake}}{{#if doubled}} ×2{{/if}}</span>{{#if result}}<span class="cz-res">{{resultLabel}}</span>{{/if}}</div>
            </div>
            {{/each}}
            {{#if net}}<div class="cz-net {{netCls}}">{{net}}</div>{{/if}}
            {{#if bet}}<div class="cz-chips" title="{{t "Bet for the next round"}}"><span class="cz-chip"></span>{{bet}}</div>{{/if}}
            {{#if betting}}
            <div class="cz-mine">
              <input type="number" class="cz-bet" name="cz-bet-{{id}}" data-seat="{{id}}" value="{{betDefault}}" min="{{../sys.minBet}}" max="{{../sys.maxBet}}" step="1" data-enter=".cz-betbtn[data-seat='{{id}}']" title="{{t "Bet ({min}–{max})" min=../sys.minBet max=../sys.maxBet}}">
              <button type="button" class="cz-betbtn" data-action="bet" data-seat="{{id}}">{{t "bj|Bet"}}</button>
              {{#if bet}}<button type="button" data-action="bet" data-seat="{{id}}" data-amount="0" title="{{t "Withdraw the bet"}}">✕</button>{{/if}}
              <button type="button" class="cz-leave" data-action="leave" data-seat="{{id}}" title="{{t "Leave the table"}}">{{t "Stand up"}}</button>
            </div>
            {{else}}{{#if me}}{{#unless ../v.playing}}<div class="cz-mine"><button type="button" class="cz-leave" data-action="leave" data-seat="{{id}}">{{t "Stand up"}}</button></div>{{/unless}}{{/if}}
            {{/if}}
          {{else}}
            <div class="cz-cards hole">{{{cards}}}</div>
            {{#if secret}}<div class="cz-note">{{t "only the GM sees these cards"}}</div>{{/if}}
            <div class="cz-hinfo">
              <span class="cz-stack" title="{{t "Caps on the table"}}"><span class="cz-chip"></span>{{stack}}</span>
              {{#if bet}}<span class="cz-stake" title="{{t "Bet in this round"}}">{{bet}}</span>{{/if}}
              {{#if lastAction}}<span class="cz-act">{{lastAction}}</span>{{/if}}
            </div>
            {{#if best}}<div class="cz-best">{{best}}</div>{{/if}}
            {{#if won}}<div class="cz-net win">+{{won}}</div>{{/if}}
            {{#if canLeave}}
            <div class="cz-mine">
              {{#if canRebuy}}
              <input type="number" class="cz-rebuy" name="cz-rebuy-{{id}}" data-seat="{{id}}" value="{{rebuyDefault}}" min="1" max="{{rebuyMax}}" step="1" data-enter=".cz-rebuybtn[data-seat='{{id}}']" title="{{t "Buy more caps (at most {n})" n=rebuyMax}}">
              <button type="button" class="cz-rebuybtn" data-action="rebuy" data-seat="{{id}}">{{t "Buy more"}}</button>
              {{/if}}
              <button type="button" class="cz-leave" data-action="leave" data-seat="{{id}}" title="{{t "Leave the table (the caps go back)"}}">{{t "Stand up"}}</button>
            </div>
            {{/if}}
          {{/if}}
        </div>
        {{else}}<p class="cz-empty">{{t "Nobody sits at the table."}}</p>{{/each}}
      </div>
    </div>

    <div class="cz-controls">
      {{#if v.ctl.status}}<div class="cz-status">{{v.ctl.status}}</div>{{/if}}
      <div class="cz-buttons">
        {{#with v.ctl.sit}}
          {{#if ok}}
            {{#if buyIn}}<label class="cz-inp">{{t "buy-in"}} <input type="number" name="cz-buyin" value="{{buyDefault}}" min="{{buyMin}}" max="{{buyMax}}" step="1" data-enter=".cz-sitbtn"></label>{{/if}}
            <button type="button" class="cz-sitbtn primary" data-action="sit"><i class="fa-solid fa-chair"></i> {{t "Sit down: {who} ({caps})" who=who caps=capsLabel}}</button>
          {{else}}<span class="cz-why">{{why}}</span>{{/if}}
        {{/with}}
        {{#if v.ctl.deal}}<button type="button" class="primary" data-action="deal"><i class="fa-solid fa-layer-group"></i> {{t "Deal"}}</button>{{/if}}
        {{#if v.ctl.start}}<button type="button" class="primary" data-action="start"><i class="fa-solid fa-layer-group"></i> {{t "New hand"}}</button>{{/if}}
        {{#with v.ctl.bjTurn}}
          <span class="cz-turn">{{name}}{{#if hand}} — {{hand}}{{/if}}: <b>{{total}}</b></span>
          <button type="button" class="primary" data-action="act" data-seat="{{seat}}" data-act="hit">{{t "bj|Hit"}}</button>
          <button type="button" class="primary" data-action="act" data-seat="{{seat}}" data-act="stand">{{t "bj|Stand"}}</button>
          {{#if double}}<button type="button" data-action="act" data-seat="{{seat}}" data-act="double" {{#if short}}title="{{t "Not enough caps"}}"{{/if}}>{{t "Double (+{n})" n=cost}}</button>{{/if}}
          {{#if split}}<button type="button" data-action="act" data-seat="{{seat}}" data-act="split" {{#if short}}title="{{t "Not enough caps"}}"{{/if}}>{{t "Split (+{n})" n=cost}}</button>{{/if}}
        {{/with}}
        {{#with v.ctl.heTurn}}
          <span class="cz-turn">{{name}}:</span>
          <button type="button" data-action="act" data-seat="{{seat}}" data-act="fold">{{t "he|Fold"}}</button>
          {{#if check}}<button type="button" class="primary" data-action="act" data-seat="{{seat}}" data-act="check">{{t "he|Check"}}</button>{{/if}}
          {{#if call}}<button type="button" class="primary" data-action="act" data-seat="{{seat}}" data-act="call">{{t "Call {n}" n=callAmount}}</button>{{/if}}
          {{#if raise}}
            <label class="cz-inp"><input type="number" name="cz-raise" value="{{minTo}}" min="{{minTo}}" max="{{maxTo}}" step="1" data-enter=".cz-raisebtn"></label>
            <button type="button" class="cz-raisebtn" data-action="raise" data-seat="{{seat}}">{{raiseLabel}}</button>
          {{/if}}
          {{#if allIn}}<button type="button" class="allin" data-action="act" data-seat="{{seat}}" data-act="allin">{{t "All-in ({n})" n=allInTo}}</button>{{/if}}
        {{/with}}
        {{#with v.ctl.force}}<button type="button" class="gm" data-action="force" data-seat="{{seat}}" data-act="{{act}}" title="{{t "The player doesn't respond — the GM makes the move for them"}}">{{label}} ({{name}})</button>{{/with}}
      </div>
      {{#with v.ctl.gm}}
      <div class="cz-gm">
        <span>{{t "GM:"}}</span>
        {{#if npcBuy}}<label class="cz-inp" title="{{t "The NPC's caps for the table (from its sheet, or from the GM when it has too few)"}}">{{t "NPC brings"}} <input type="number" name="cz-npcbuy" value="{{buyMin}}" min="{{buyMin}}" max="{{buyMax}}" step="1"></label>{{/if}}
        <button type="button" class="gm" data-action="seatNpc" title="{{t "Seat the NPCs selected on the map at the table"}}"><i class="fa-solid fa-user-plus"></i> {{t "Seat selected NPCs"}}</button>
        {{#if playing}}<button type="button" class="gm" data-action="voidHand"><i class="fa-solid fa-ban"></i> {{t "Void the hand"}}</button>{{/if}}
      </div>
      {{/with}}
    </div>

    <div class="cz-log">{{#each v.log}}<div>{{this}}</div>{{else}}<div class="cz-empty">{{t "The dealer's log is empty."}}</div>{{/each}}</div>
  </div>
{{/if}}
</section>
